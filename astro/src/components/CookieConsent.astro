---
// Cookie-consent banner + Google Consent Mode v2 wiring for Google
// Analytics. Region-aware (changed 2026-11-07): in the EEA, UK and
// Switzerland analytics storage is denied until the visitor accepts; in the
// U.S. and elsewhere, where privacy law uses an opt-out model, analytics is
// on by default and the visitor can reject it here or from "Privacy
// choices." The earlier load-only-after-accept design hid nearly all U.S.
// visitors from reporting. A stored "Reject" means gtag.js is never loaded. See
// astro/src/lib/analytics/config.ts for the on/off switch and measurement
// ID, and /privacy/ for the plain-language explanation shown to visitors.
//
// The footer's "Privacy choices" control and this page's own /privacy/#choices
// section both reopen this same banner via a `data-open-cookie-prefs`
// attribute — event delegation below means any element with that attribute,
// anywhere in the DOM, works without this component needing to know about it.
import { ANALYTICS_ENABLED, GA_MEASUREMENT_ID } from "@lib/analytics/config";
---
{ANALYTICS_ENABLED && (
  <div id="cookie-consent-banner" class="cookie-banner" role="region" aria-label="Cookie preferences" tabindex="-1" hidden>
    <p>
      We use Google Analytics to count visits and see which pages are useful — never what you type
      into a calculator. You can accept or reject it, and change your mind any time under
      "Privacy choices." See the <a href="/privacy/">privacy policy</a>.
    </p>
    <div class="cookie-banner-actions">
      <button type="button" id="cookie-reject-btn" class="btn-secondary">Reject</button>
      <button type="button" id="cookie-accept-btn" class="btn-primary">Accept</button>
    </div>
  </div>
  <script define:vars={{ gaId: GA_MEASUREMENT_ID }} is:inline>
    (function () {
      var STORAGE_KEY = "fcc-analytics-consent";
      var banner = document.getElementById("cookie-consent-banner");
      var acceptBtn = document.getElementById("cookie-accept-btn");
      var rejectBtn = document.getElementById("cookie-reject-btn");

      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      window.gtag = window.gtag || gtag;

      // Consent Mode v2 defaults, set before gtag.js loads. Analytics:
      // denied in opt-in regions until the visitor accepts, granted elsewhere
      // until the visitor rejects.
      //
      // Advertising consent is owned by Google's own certified CMP
      // (AdSense → Privacy & messaging), which shows the IAB TCF message to
      // EEA/UK/Swiss visitors and the U.S. state-privacy opt-out message,
      // and updates these ad_* signals itself. This banner never grants
      // ad_* categories. Defaults: denied in regions that require opt-in
      // consent, granted elsewhere (U.S. state laws use an opt-out model,
      // which Google's U.S. states message provides).
      var OPT_IN_REGIONS = ["AT","BE","BG","HR","CY","CZ","DK","EE","FI","FR","DE","GR","HU","IS","IE","IT","LV","LI","LT","LU","MT","NL","NO","PL","PT","RO","SK","SI","ES","SE","GB","CH"];
      gtag("consent", "default", {
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        analytics_storage: "denied",
        region: OPT_IN_REGIONS,
      });
      gtag("consent", "default", {
        ad_storage: "granted",
        ad_user_data: "granted",
        ad_personalization: "granted",
        analytics_storage: "granted",
      });

      function loadGaScript() {
        if (document.getElementById("ga-gtag-script")) return;
        var s = document.createElement("script");
        s.id = "ga-gtag-script";
        s.async = true;
        s.src = "https://www.googletagmanager.com/gtag/js?id=" + gaId;
        document.head.appendChild(s);
        gtag("js", new Date());
        gtag("config", gaId);
      }

      function hideBanner() { if (banner) banner.hidden = true; }
      function showBanner() { if (banner) banner.hidden = false; }

      function grant() {
        gtag("consent", "update", { analytics_storage: "granted" });
        loadGaScript();
        try { localStorage.setItem(STORAGE_KEY, "granted"); } catch (e) {}
        hideBanner();
      }

      function deny() {
        gtag("consent", "update", { analytics_storage: "denied" });
        try { localStorage.setItem(STORAGE_KEY, "denied"); } catch (e) {}
        hideBanner();
      }

      var stored = null;
      try { stored = localStorage.getItem(STORAGE_KEY); } catch (e) {}

      if (stored === "granted") {
        gtag("consent", "update", { analytics_storage: "granted" });
        loadGaScript();
      } else if (stored === "denied") {
        gtag("consent", "update", { analytics_storage: "denied" });
      } else {
        // No choice yet: load with the regional defaults above and ask.
        loadGaScript();
        showBanner();
      }

      if (acceptBtn) acceptBtn.addEventListener("click", grant);
      if (rejectBtn) rejectBtn.addEventListener("click", deny);

      // Reopen from the footer link or the /privacy/#choices page control.
      document.addEventListener("click", function (e) {
        var target = e.target && e.target.closest ? e.target.closest("[data-open-cookie-prefs]") : null;
        if (target) {
          e.preventDefault();
          showBanner();
          if (banner) banner.focus();
        }
      });
    })();
  </script>
)}

<style>
  .cookie-banner {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 100;
    background: var(--color-bg);
    border-top: 1px solid var(--color-border);
    box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.08);
    padding: 16px 20px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }

  /* `display: flex` above would otherwise override the hidden attribute,
     leaving the banner on screen after a choice was made. */
  .cookie-banner[hidden] {
    display: none;
  }

  .cookie-banner p {
    margin: 0;
    font-size: 0.88rem;
    color: var(--color-text);
    max-width: 640px;
  }

  .cookie-banner-actions {
    display: flex;
    gap: 10px;
    flex-shrink: 0;
  }

  .cookie-banner-actions button {
    min-height: var(--touch-target-min);
    padding: 10px 20px;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.9rem;
    cursor: pointer;
  }

  #cookie-accept-btn {
    background: var(--color-primary);
    color: #fff;
    border: 1px solid var(--color-primary);
  }
  #cookie-accept-btn:hover { background: var(--color-primary-dark); }

  #cookie-reject-btn {
    background: var(--color-bg);
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }
  #cookie-reject-btn:hover { border-color: var(--color-primary); color: var(--color-primary); }

  @media (max-width: 560px) {
    .cookie-banner { flex-direction: column; align-items: stretch; }
    .cookie-banner-actions { justify-content: stretch; }
    .cookie-banner-actions button { flex: 1; }
  }
</style>
