---
/**
 * Manual AdSense display unit. Renders nothing at all — no element, no
 * reserved space — unless ads are serving (see @lib/ads/config), the page
 * is ad-eligible, and a unit ID has been configured for this slot name.
 *
 * Placement rules every usage must keep:
 *   - a visible "Advertisement" label;
 *   - never styled like a calculator control, nav item, result or button;
 *   - never adjacent to a form field, submit button or result panel.
 */
import { ADSENSE_PUBLISHER_ID, AD_UNIT_IDS, isAdEligible, type AdSlotName } from "@lib/ads/config";

interface Props {
  /** Site-relative path of the current page, e.g. "/guides/total-loss/foo/". */
  path: string;
  slot: AdSlotName;
}

const { path, slot } = Astro.props;
const unitId: string = AD_UNIT_IDS[slot];
const show = isAdEligible(path) && unitId !== "";
---
{show && (
  <aside class="ad-slot" aria-label="Advertisement">
    <p class="ad-label">Advertisement</p>
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={ADSENSE_PUBLISHER_ID}
      data-ad-slot={unitId}
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
  </aside>
)}

<style>
  .ad-slot {
    margin: 32px 0;
    padding-top: 8px;
    border-top: 1px solid var(--color-border);
    min-height: 120px;
  }
  .ad-label {
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0 0 6px;
  }
</style>
