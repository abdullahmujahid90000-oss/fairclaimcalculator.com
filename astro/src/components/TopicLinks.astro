---
/**
 * "In this topic" block: up to the pillar, across to the previous and next
 * page in the cluster's reading order, and to the cluster's main tools.
 * Data: src/lib/seo/topic-clusters.ts. Rendered by BaseLayout for any page
 * that belongs to a cluster; renders nothing otherwise.
 */
import { getTopicLinks } from "@lib/seo/topic-clusters";

interface Props {
  path: string;
}

const links = getTopicLinks(Astro.props.path);
---
{links && (
  <div class="container">
    <nav class="topic-links" aria-labelledby="topic-links-heading">
      <h2 id="topic-links-heading">In this topic: {links.cluster.name}</h2>
      <ul>
        {links.previous && (
          <li><span class="topic-dir">Previous</span> <a href={links.previous.href}>{links.previous.label}</a></li>
        )}
        {links.next && (
          <li><span class="topic-dir">Next</span> <a href={links.next.href}>{links.next.label}</a></li>
        )}
        {links.tools.map((t) => (
          <li><span class="topic-dir">{t.kind === "form" ? "Template" : t.kind === "guide" ? "Guide" : "Tool"}</span> <a href={t.href}>{t.label}</a></li>
        ))}
        <li><span class="topic-dir">Overview</span> <a href={links.cluster.pillar.href}>{links.cluster.pillar.label}</a></li>
      </ul>
    </nav>
  </div>
)}

<style>
  .topic-links {
    border-top: 1px solid var(--color-border);
    margin: 8px 0 48px;
    padding-top: 20px;
  }
  .topic-links h2 { font-size: 1.05rem; margin: 0 0 12px; color: var(--color-primary-dark); }
  .topic-links ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .topic-links li { display: grid; grid-template-columns: 76px minmax(0, 1fr); gap: 10px; align-items: baseline; }
  .topic-dir {
    color: var(--color-text-muted);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }
  .topic-links a { min-height: 24px; }
</style>
