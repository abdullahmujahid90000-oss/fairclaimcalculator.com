---
// Renders a visible, accessible FAQ list using native <details>/<summary>
// disclosure widgets (no custom JS needed for expand/collapse, works with
// keyboard and screen readers out of the box). Pass the SAME faqs array to
// buildFaqSchema() (src/lib/seo/faq-schema.ts) in the page's structuredData
// so the FAQPage JSON-LD always matches this visible text exactly.
import type { FaqItem } from "@lib/seo/faq-schema";

interface Props {
  faqs: FaqItem[];
  heading?: string;
}

const { faqs, heading = "Frequently Asked Questions" } = Astro.props;
---
<section class="faq-section" aria-labelledby="faq-heading">
  <h2 id="faq-heading">{heading}</h2>
  <div class="faq-list">
    {faqs.map((faq) => (
      <details class="faq-item">
        <summary>{faq.question}</summary>
        <p>{faq.answer}</p>
      </details>
    ))}
  </div>
</section>

<style>
  .faq-section { margin: 34px 0; }
  .faq-list { display: flex; flex-direction: column; gap: 10px; margin-top: 14px; }
  .faq-item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 14px 16px;
  }
  .faq-item summary {
    cursor: pointer;
    font-weight: 700;
    color: var(--color-primary-dark);
    min-height: var(--touch-target-min);
    display: flex;
    align-items: center;
  }
  .faq-item summary:hover { color: var(--color-primary); }
  .faq-item p { margin: 10px 0 0; color: var(--color-text); }
  .faq-item[open] summary { margin-bottom: 2px; }
</style>
