---
interface Props {
  name: string;
  href: string;
  status?: "live" | "coming-soon";
}
const { name, href, status = "live" } = Astro.props;
---
<a href={href} class="calculator-card">
  <span class:list={["calculator-card-status", status]}>
    {status === "live" ? "Live now" : "In progress"}
  </span>
  <h3>{name}</h3>
  <p><slot /></p>
</a>

<style>
  .calculator-card {
    display: block;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 18px;
    text-decoration: none;
    color: inherit;
    background: var(--color-bg);
  }

  .calculator-card:hover, .calculator-card:focus-visible {
    border-color: var(--color-primary);
  }

  .calculator-card h3 { margin: 6px 0 6px; font-size: 1.05rem; }
  .calculator-card p { margin: 0; font-size: 0.88rem; color: var(--color-text-muted); }

  .calculator-card-status {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    padding: 3px 8px;
    border-radius: 999px;
    background: var(--color-bg-soft);
    color: var(--color-text-muted);
  }

  .calculator-card-status.live {
    background: #dcfce7;
    color: var(--color-primary-dark);
  }
</style>
