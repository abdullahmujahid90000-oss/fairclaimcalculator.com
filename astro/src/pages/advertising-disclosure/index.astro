---
import BaseLayout from "@layouts/BaseLayout.astro";

const title = "Advertising Disclosure | FairClaimCalculator";
const description =
  "FairClaimCalculator is supported by Google AdSense ads. How ads are placed, what advertisers can't influence, and your choices.";
const path = "/advertising-disclosure/";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://www.fairclaimcalculator.com/" },
      { "@type": "ListItem", position: 2, name: "Advertising Disclosure", item: `https://www.fairclaimcalculator.com${path}` },
    ],
  },
];
---
<BaseLayout title={title} description={description} path={path} structuredData={structuredData}>
  <div class="container">
    <p class="breadcrumb-text"><a href="/">Home</a> / Advertising Disclosure</p>
    <h1 class="page-title">Advertising Disclosure</h1>

    <p class="lead">
      FairClaimCalculator is free to use and is supported by display advertising from Google
      AdSense. Advertising pays for hosting and research time; it never changes a calculator's math
      or what a guide says.
    </p>

    <div class="calc-card">
      <h2>How ads appear on this site</h2>
      <ul>
        <li>Every ad is labeled "Advertisement" or served in Google's own clearly marked ad frame.</li>
        <li>Ads are placed in guides and below the FAQ on calculator pages — never inside a calculator form, next to its buttons, or inside your results.</li>
        <li>No ads appear on legal, trust, contact or error pages.</li>
        <li>Advertisers are chosen by Google's ad auction, not by this site. An ad for an insurer, law firm or appraiser is not an endorsement, and they pay us nothing to influence content.</li>
      </ul>

      <h2 class="section-heading">What this site does not do</h2>
      <ul>
        <li>It does not accept payment from any insurance company, law firm, appraisal company, or vendor to influence a calculator's arithmetic or a guide's content.</li>
        <li>It does not use affiliate links, sponsored posts, or lead-generation forms that sell your information.</li>
        <li>It does not require an account, email address, or login to use any calculator.</li>
        <li>It never sends what you type into a calculator to Google or anyone else.</li>
      </ul>

      <h2 class="section-heading">Your choices</h2>
      <p>
        How advertising cookies work and how to opt out of personalized ads is explained in the
        <a href="/privacy/#advertising">privacy policy</a>.
      </p>
    </div>

    <div class="disclaimer-box">
      <strong>Questions about this disclosure?</strong>
      Use the <a href="/contact/">contact page</a>.
    </div>
  </div>
</BaseLayout>
