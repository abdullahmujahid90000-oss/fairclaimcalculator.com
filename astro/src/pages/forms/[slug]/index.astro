---
import BaseLayout from "@layouts/BaseLayout.astro";
import FaqSection from "@components/FaqSection.astro";
import AdSlot from "@components/AdSlot.astro";
import { DOWNLOAD_PAGES, DOWNLOADS_REVIEWED, type DownloadPage } from "@lib/content/downloads";
import { buildFaqSchema } from "@lib/seo/faq-schema";
import { AUTHOR } from "@lib/site/author";
import { PDF_TEMPLATES } from "../../../../scripts/pdf-templates.mjs";

export function getStaticPaths() {
  return DOWNLOAD_PAGES.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props as { page: DownloadPage };
const template = PDF_TEMPLATES.find((t) => t.slug === page.slug);
const path = `/forms/${page.slug}/`;
const pdfHref = `/downloads/${page.slug}.pdf`;
const siteOrigin = "https://www.fairclaimcalculator.com";

// "What the form asks for": every field, row, table and checklist item in the PDF, in order.
const blocks = (template?.blocks ?? []) as Array<Record<string, unknown>>;
const inside = blocks
  .map((b) =>
    Array.isArray(b.row) ? (b.row as string[]).join(" · ")
    : typeof b.field === "string" ? b.field
    : Array.isArray(b.table) ? `A ${b.rows}-row table: ${(b.table as string[]).join(" · ")}`
    : typeof b.check === "string" ? `☐ ${b.check}`
    : null,
  )
  .filter((item): item is string => item !== null);

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${siteOrigin}/` },
      { "@type": "ListItem", position: 2, name: "Free Forms & Templates", item: `${siteOrigin}/forms/` },
      { "@type": "ListItem", position: 3, name: page.title, item: `${siteOrigin}${path}` },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "DigitalDocument",
    name: page.title,
    description: page.description,
    url: `${siteOrigin}${pdfHref}`,
    encodingFormat: "application/pdf",
    isAccessibleForFree: true,
    inLanguage: "en-US",
    dateModified: DOWNLOADS_REVIEWED,
    publisher: { "@type": "Organization", name: "FairClaimCalculator", url: `${siteOrigin}/` },
  },
  buildFaqSchema(page.faqs),
];
---
<BaseLayout title={page.metaTitle} description={page.description} path={path} structuredData={structuredData}>
  <div class="container guide-container">
    <p class="breadcrumb-text"><a href="/">Home</a> / <a href="/forms/">Free Forms &amp; Templates</a></p>
    <h1 class="page-title">{page.title}</h1>
    <p class="lead">{template?.intro}</p>

    <div class="download-box">
      <a class="btn-primary" href={pdfHref} download>Download the free PDF</a>
      <p>Fillable on screen or printable · no email or sign-up · last reviewed {DOWNLOADS_REVIEWED} by <a href={AUTHOR.aboutHref}>{AUTHOR.name}</a></p>
    </div>

    <h2>When to use it</h2>
    <ul>{page.whenToUse.map((item) => <li>{item}</li>)}</ul>

    {inside.length > 0 && (
      <>
        <h2>What the form asks for</h2>
        <ul>{inside.map((item) => <li>{item}</li>)}</ul>
      </>
    )}

    <AdSlot path={path} slot="guide-top" />

    <h2>How to fill it in</h2>
    <ol>{page.howTo.map((step) => <li>{step}</li>)}</ol>

    <FaqSection faqs={page.faqs} />

    <div class="disclaimer-box">
      <strong>A template, not legal advice.</strong> Edit it to match your facts. For complex,
      high-value or injury claims, consider a licensed attorney or independent appraiser in your
      state. See the <a href="/disclaimer/">disclaimer</a>.
    </div>

    <h2>Related tools &amp; guides</h2>
    <div class="related-tools">
      {page.related.map((link) => <a href={link.href}>{link.label} →</a>)}
      <a href="/forms/">All free forms &amp; templates →</a>
    </div>
  </div>
</BaseLayout>

<style>
  .guide-container { max-width: 760px; }
  .download-box {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 18px;
    margin: 20px 0 8px;
    background: var(--color-bg-soft, transparent);
  }
  .download-box .btn-primary { display: inline-block; text-decoration: none; }
  .download-box p { margin: 10px 0 0; font-size: 0.85rem; color: var(--color-text-muted); }
  ul, ol { padding-left: 22px; }
  li { margin-bottom: 6px; }
</style>
