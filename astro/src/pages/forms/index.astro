---
import BaseLayout from "@layouts/BaseLayout.astro";
import { DOWNLOAD_PAGES } from "@lib/content/downloads";

const title = "Free Car Insurance Claim Forms & Templates (PDF)";
const description =
  "Free fillable PDF templates for car accident and insurance claims: accident information sheet, claim log, total-loss and diminished value letters, complaint worksheet and more.";
const path = "/forms/";
const siteOrigin = "https://www.fairclaimcalculator.com";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${siteOrigin}/` },
      { "@type": "ListItem", position: 2, name: "Free Forms & Templates", item: `${siteOrigin}${path}` },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Free car insurance claim templates",
    itemListElement: DOWNLOAD_PAGES.map((d, i) => ({
      "@type": "ListItem",
      position: i + 1,
      url: `${siteOrigin}/forms/${d.slug}/`,
      name: d.title,
    })),
  },
];
---
<BaseLayout title={title} description={description} path={path} structuredData={structuredData}>
  <div class="container">
    <p class="breadcrumb-text"><a href="/">Home</a> / Free Forms &amp; Templates</p>
    <h1 class="page-title">Free Car Insurance Claim Forms &amp; Templates</h1>
    <p class="lead">
      Eight free, fillable PDFs for every stage of a car insurance claim — from the scene of the
      crash to disputing an offer. Fill them on screen or print them. No email or sign-up.
    </p>

    <div class="notice">
      Looking for your state's <strong>official crash report form</strong> (like California's SR-1
      or New York's MV-104)? Those change often, so we link straight to the official version on each
      state's page: <a href="/guides/accident-reporting/">car accident reporting rules by state</a>.
    </div>

    <div class="guide-hub-grid">
      {DOWNLOAD_PAGES.map((d) => (
        <a href={`/forms/${d.slug}/`} class="guide-hub-card">
          <h2>{d.title.replace(/ \(Free PDF.*\)$/, "")}</h2>
          <p>{d.cardText}</p>
          <span class="card-tag">PDF · fillable</span>
        </a>
      ))}
    </div>

    <div class="disclaimer-box">
      <strong>Templates, not legal advice.</strong>
      These are general-purpose templates written for this site. Edit them to fit your situation, and
      consider a licensed professional for complex or high-value claims. See the
      <a href="/disclaimer/">disclaimer</a>.
    </div>
  </div>
</BaseLayout>

<style>
  .guide-hub-grid { display: grid; gap: 16px; grid-template-columns: repeat(2, minmax(0, 1fr)); margin: 24px 0 30px; }
  @media (max-width: 640px) { .guide-hub-grid { grid-template-columns: 1fr; } }
  .guide-hub-card { display: block; border: 1px solid var(--color-border); border-radius: var(--radius); padding: 18px; text-decoration: none; color: inherit; }
  .guide-hub-card:hover, .guide-hub-card:focus-visible { border-color: var(--color-primary); }
  .guide-hub-card h2 { margin: 0 0 6px; font-size: 1.02rem; color: var(--color-primary-dark); }
  .guide-hub-card p { margin: 0 0 8px; font-size: 0.88rem; color: var(--color-text-muted); }
  .card-tag { font-size: 0.75rem; font-weight: 700; color: var(--color-primary); }
</style>
