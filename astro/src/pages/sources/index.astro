---
import BaseLayout from "@layouts/BaseLayout.astro";
import { SETTLEMENT_BREAKDOWN_CONFIG } from "@lib/calculators/settlement-breakdown";
import { TOTAL_LOSS_AUDIT_CONFIG } from "@lib/calculators/total-loss-audit";
import { DV_CONFIG } from "@lib/calculators/diminished-value-baseline";
import { LETTER_BUILDER_CONFIG } from "@lib/calculators/claim-letter-builder";
import { LOSS_OF_USE_CONFIG } from "@lib/calculators/loss-of-use";
import { SALVAGE_VALUE_CONFIG } from "@lib/calculators/salvage-value";

const title = "Source Register | FairClaimCalculator";
const description =
  "The public register of sources actually cited by FairClaimCalculator's calculators, kept in sync with the site's internal source register.";
const path = "/sources/";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://www.fairclaimcalculator.com/" },
      { "@type": "ListItem", position: 2, name: "Sources", item: `https://www.fairclaimcalculator.com${path}` },
    ],
  },
];

const groups = [
  { name: "Settlement Check Breakdown", href: "/calculators/settlement-check-breakdown/", sources: SETTLEMENT_BREAKDOWN_CONFIG.sources },
  { name: "Total-Loss Offer Audit", href: "/calculators/total-loss-offer-audit/", sources: TOTAL_LOSS_AUDIT_CONFIG.sources },
  { name: "Diminished Value Baseline", href: "/calculators/diminished-value-baseline/", sources: DV_CONFIG.sources },
  { name: "Rental / Loss-of-Use Reimbursement", href: "/calculators/loss-of-use-reimbursement/", sources: LOSS_OF_USE_CONFIG.sources },
  { name: "Salvage / Owner-Retained Value", href: "/calculators/salvage-value/", sources: SALVAGE_VALUE_CONFIG.sources },
  { name: "Leased Vehicle Diminished Value", href: "/calculators/leased-vehicle-diminished-value/", sources: DV_CONFIG.sources },
  { name: "Claim Letter & Evidence Packet Builder", href: "/calculators/claim-letter-builder/", sources: LETTER_BUILDER_CONFIG.sources },
];
---
<BaseLayout title={title} description={description} path={path} structuredData={structuredData}>
  <div class="container">
    <p class="breadcrumb-text"><a href="/">Home</a> / Sources</p>
    <h1 class="page-title">Source Register</h1>
    <p class="lead">
      Every source actually relied on for a calculator's arithmetic or a guide's factual claims is
      listed here, grouped by the page that cites it. See the <a href="/editorial-policy/">editorial
      policy</a> for how sources are chosen.
    </p>

    <div class="notice">
      This page covers the seven calculators' formula and methodology sources below. The 23-guide
      library's sources are cited inline on each guide's own page (in its "Sources" section) rather
      than duplicated here — see the summary and links in the Guides section further down.
    </div>

    {groups.map((group) => (
      <div class="calc-card">
        <h2>{group.name}</h2>
        <ul class="quality-list">
          {group.sources.map((source: string) => <li>{source}</li>)}
        </ul>
        <p><a href={group.href}>Open this calculator →</a></p>
      </div>
    ))}

    <div class="calc-card">
      <h2>Guides</h2>
      <p>
        Each of the 23 guides in the <a href="/guides/">guide library</a> cites its own sources
        inline, next to the claim, in a Sources section at the bottom of the page. Sources include
        primary government and regulatory records (e.g., the NAIC's Unfair Claims Settlement
        Practices Act, the Texas Comptroller's insurance-settlement-transfer rules, the New York
        DFS's salvage-title opinion, and the New Hampshire Insurance Department's list of accepted
        valuation methods) alongside general concept explanations and this site's own methodology
        notes, each labeled for what it is.
      </p>
      <ul class="quality-list">
        <li><a href="/guides/total-loss/">Total Loss guides (10)</a></li>
        <li><a href="/guides/diminished-value/">Diminished Value guides (6)</a></li>
        <li><a href="/guides/claim-process/">Claim Process guides (7)</a></li>
      </ul>
    </div>

    <div class="disclaimer-box">
      <strong>Found a sourcing error?</strong>
      Use the <a href="/corrections/">corrections page</a> to report it, or the
      <a href="/contact/">contact page</a> to reach the editor directly.
    </div>
  </div>
</BaseLayout>
