---
import BaseLayout from "@layouts/BaseLayout.astro";
import ErrorSummary from "@components/ErrorSummary.astro";
import FaqSection from "@components/FaqSection.astro";
import {
  EVIDENCE_CHECKLIST,
  LETTER_BUILDER_CONFIG,
  LETTER_MODES,
} from "@lib/calculators/claim-letter-builder";
import { buildFaqSchema, type FaqItem } from "@lib/seo/faq-schema";

const title = "Claim Letter & Evidence Packet Builder | FairClaimCalculator";
const description =
  "Generate an editable, factual auto-claim letter and evidence checklist in your browser. No threats, fake deadlines, account, or email required.";
const path = "/calculators/claim-letter-builder/";

const faqs: FaqItem[] = [
  {
    question: "Does this tool send the letter for me?",
    answer:
      "No. It only generates an editable plain-text draft. You choose how and when to send it, and nothing here creates a legal filing, provides legal advice, or guarantees a response.",
  },
  {
    question: "Why does my draft have bracketed placeholders like [Your Name]?",
    answer:
      "Any field you leave blank stays as an obvious bracketed placeholder instead of being guessed or filled in automatically. This tool never invents names, dates, claim numbers, or other details on your behalf.",
  },
  {
    question: "Can I get a template for filing a state insurance-department complaint?",
    answer:
      "Not yet. A state complaint template isn't offered until that specific state's current workflow and sources have been verified — this site doesn't publish placeholder legal content.",
  },
  {
    question: "Why don't the templates mention bad faith or legal deadlines?",
    answer:
      "The drafts deliberately contain no threats, fake deadlines, or unsupported \"bad faith\" accusations. Every request is a narrow, factual ask you can defend if someone asks what you meant.",
  },
  {
    question: "Is anything I type sent to a server?",
    answer:
      "No. Your letter fields and the generated draft stay in your browser. Evidence-checklist checkboxes reset when you reload the page and are never transmitted or stored anywhere.",
  },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://www.fairclaimcalculator.com/" },
      { "@type": "ListItem", position: 2, name: "Calculators", item: "https://www.fairclaimcalculator.com/calculators/" },
      { "@type": "ListItem", position: 3, name: "Claim Letter Builder", item: `https://www.fairclaimcalculator.com${path}` },
    ],
  },
  buildFaqSchema(faqs),
];
---
<BaseLayout title={title} description={description} path={path} structuredData={structuredData}>
  <div class="container">
    <p class="breadcrumb-text"><a href="/">Home</a> / <a href="/calculators/">Calculators</a> / Claim Letter Builder</p>
    <h1 class="page-title">Build a Factual Claim Letter and Evidence Checklist</h1>
    <p class="lead">
      Choose one narrow request, enter what you know, and get an editable plain-text draft. Missing
      facts remain obvious bracketed placeholders so the tool never invents names, dates, or claim details.
    </p>
    <ul class="trust-badges">
      <li><span aria-hidden="true">🔒</span> Text stays in your browser</li>
      <li><span aria-hidden="true">✏️</span> Fully editable before use</li>
      <li><span aria-hidden="true">🖨️</span> Copy, print, or save locally as PDF</li>
    </ul>

    <div class="calc-card">
      <h2>Choose a Letter and Add Your Facts</h2>
      <ErrorSummary id="letter-error-summary" />

      <form id="claim-letter-form" novalidate>
        <div class="form-grid">
          <div class="field field-wide">
            <label for="letterMode">What do you need to ask for?</label>
            <select id="letterMode" name="letterMode" aria-describedby="letterMode-hint">
              {LETTER_MODES.map((mode) => <option value={mode.key}>{mode.label}</option>)}
            </select>
            <p class="hint" id="letterMode-hint">Each template makes one focused factual request. It does not send anything for you.</p>
          </div>
          <div class="field">
            <label for="yourName">Your name</label>
            <input type="text" id="yourName" name="yourName" maxlength="120" autocomplete="name" aria-describedby="yourName-hint" />
            <p class="hint" id="yourName-hint">Optional. Blank becomes [Your Name].</p>
          </div>
          <div class="field">
            <label for="insurerName">Insurer name</label>
            <input type="text" id="insurerName" name="insurerName" maxlength="160" aria-describedby="insurerName-hint" />
            <p class="hint" id="insurerName-hint">Optional. Copy the legal name from your claim paperwork.</p>
          </div>
          <div class="field">
            <label for="adjusterName">Adjuster or recipient name</label>
            <input type="text" id="adjusterName" name="adjusterName" maxlength="120" />
          </div>
          <div class="field">
            <label for="claimNumber">Claim number</label>
            <input type="text" id="claimNumber" name="claimNumber" maxlength="100" />
          </div>
          <div class="field">
            <label for="vehicleDesc">Vehicle</label>
            <input type="text" id="vehicleDesc" name="vehicleDesc" maxlength="160" aria-describedby="vehicleDesc-hint" />
            <p class="hint" id="vehicleDesc-hint">Example: 2020 Honda Accord EX-L, VIN ending 1234.</p>
          </div>
          <div class="field">
            <label for="dateOfLoss">Date of loss</label>
            <input type="date" id="dateOfLoss" name="dateOfLoss" />
          </div>
          <div class="field">
            <label for="letterDate">Letter date</label>
            <input type="text" id="letterDate" name="letterDate" maxlength="80" aria-describedby="letterDate-hint" />
            <p class="hint" id="letterDate-hint">Defaults to today's date and remains editable.</p>
          </div>
        </div>

        <div class="field mode-fields" data-letter-fields="factual-correction" hidden>
          <label for="correctionDetails">What does the report show, and what fact should be corrected?</label>
          <textarea id="correctionDetails" name="correctionDetails" rows="5" maxlength="8000" aria-describedby="correctionDetails-hint"></textarea>
          <p class="hint" id="correctionDetails-hint">Be specific and name the document that supports the correction.</p>
        </div>

        <div class="field mode-fields" data-letter-fields="comparable-reconsideration" hidden>
          <label for="comparablesDetails">Comparable vehicles you want considered</label>
          <textarea id="comparablesDetails" name="comparablesDetails" rows="7" maxlength="12000" aria-describedby="comparablesDetails-hint"></textarea>
          <p class="hint" id="comparablesDetails-hint">Include year, trim, mileage, distance, price, seller, source, and date checked for each listing.</p>
        </div>

        <div class="mode-fields" data-letter-fields="dv-notice" hidden>
          <div class="field">
            <label for="repairSummary">Repair summary</label>
            <textarea id="repairSummary" name="repairSummary" rows="4" maxlength="6000" aria-describedby="repairSummary-hint"></textarea>
            <p class="hint" id="repairSummary-hint">Describe completed work factually; do not guess about damage you cannot document.</p>
          </div>
          <div class="field">
            <label for="dvBasis">Supported basis for the diminished-value notice</label>
            <textarea id="dvBasis" name="dvBasis" rows="5" maxlength="8000" aria-describedby="dvBasis-hint"></textarea>
            <p class="hint" id="dvBasis-hint">Explain the evidence you have, such as comparable listings or an independent appraisal.</p>
          </div>
        </div>

        <div class="field mode-fields" data-letter-fields="adjustment-explanation" hidden>
          <label for="adjustmentDetails">Which adjustment do you want explained?</label>
          <textarea id="adjustmentDetails" name="adjustmentDetails" rows="5" maxlength="8000" aria-describedby="adjustmentDetails-hint"></textarea>
          <p class="hint" id="adjustmentDetails-hint">Name the line item, amount, and the exact question you want answered.</p>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn-primary">Generate Letter</button>
          <button type="button" class="btn-secondary" id="letter-start-over">Start over and delete my answers</button>
        </div>
      </form>

      <section class="result-box" id="claim-letter-result" hidden aria-labelledby="letter-result-heading">
        <h2 id="letter-result-heading" tabindex="-1">Your Editable Letter Draft</h2>
        <p class="section-note" id="letter-output-hint">
          Review every line. Replace bracketed placeholders, verify the recipient and attachments,
          and change anything that is not accurate before you use it.
        </p>
        <label class="visually-hidden" for="letter-output">Editable generated claim letter</label>
        <textarea id="letter-output" class="letter-output" rows="24" aria-describedby="letter-output-hint" spellcheck="true"></textarea>
        <div class="result-actions">
          <button type="button" class="btn-primary" id="copy-letter">Copy Letter</button>
          <button type="button" class="btn-secondary" id="print-letter">Print / Save as PDF</button>
        </div>
        <p id="copy-status" class="success-note" role="status" hidden></p>
        <div class="methodology-note">
          <p><strong>Template version {LETTER_BUILDER_CONFIG.version}</strong> — last reviewed {LETTER_BUILDER_CONFIG.reviewedDate}.</p>
          <p>{LETTER_BUILDER_CONFIG.sources[0]}</p>
        </div>
      </section>
    </div>

    <section class="calc-card evidence-card" aria-labelledby="evidence-heading">
      <h2 id="evidence-heading">Evidence Checklist</h2>
      <p class="section-note">
        A general organizing list. Checkboxes stay only on this device and reset when the page is reloaded.
        Not every item applies to every claim.
      </p>
      <ul class="checklist-list">
        {EVIDENCE_CHECKLIST.map((item, index) => (
          <li>
            <input type="checkbox" id={`evidence-${index + 1}`} />
            <label for={`evidence-${index + 1}`}>{item}</label>
          </li>
        ))}
      </ul>
    </section>

    <div class="disclaimer-box">
      <strong>Before you use the draft:</strong>
      Verify every name, date, figure, statement, recipient, delivery method, and attachment. This
      tool does not send the letter, create a legal filing, provide legal advice, or guarantee a response.
    </div>

    <section>
      <h2>What these templates deliberately leave out</h2>
      <p>
        The drafts contain no threats, fake deadlines, unsupported “bad faith” accusations, or
        invented legal citations. A state insurance-department complaint template is not offered
        until a specific state's current workflow and sources have been verified.
      </p>
    </section>

    <FaqSection faqs={faqs} />

    <h2>More Calculators</h2>
    <div class="related-tools">
      <a href="/calculators/total-loss-offer-audit/">Total-Loss Offer Audit →</a>
      <a href="/calculators/diminished-value-baseline/">Diminished Value Baseline →</a>
      <a href="/calculators/leased-vehicle-diminished-value/">Leased Vehicle Diminished Value →</a>
      <a href="/calculators/settlement-check-breakdown/">Settlement Check Breakdown →</a>
      <a href="/calculators/loss-of-use-reimbursement/">Rental / Loss-of-Use Reimbursement →</a>
      <a href="/calculators/salvage-value/">Salvage / Owner-Retained Value →</a>
    </div>
  </div>
</BaseLayout>

<script>
  import {
    LETTER_MODES,
    generateLetter,
    today,
    type LetterFields,
    type LetterMode,
  } from "@lib/calculators/claim-letter-builder";
  import { trackLetterCopied, trackLetterGenerated, trackLetterPrinted } from "@lib/analytics/events";

  const form = document.getElementById("claim-letter-form") as HTMLFormElement | null;
  const result = document.getElementById("claim-letter-result");
  const resultHeading = document.getElementById("letter-result-heading");
  const output = document.getElementById("letter-output") as HTMLTextAreaElement | null;
  const errorSummary = document.getElementById("letter-error-summary");
  const errorList = document.getElementById("letter-error-summary-list");
  const copyStatus = document.getElementById("copy-status");

  if (form && result && resultHeading && output && errorSummary && errorList) {
    const value = (name: string) =>
      (form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null)?.value ?? "";
    const modeSelect = form.elements.namedItem("letterMode") as HTMLSelectElement;
    const modeGroups = form.querySelectorAll<HTMLElement>("[data-letter-fields]");

    function syncModeFields() {
      modeGroups.forEach((group) => {
        group.hidden = group.dataset.letterFields !== modeSelect.value;
      });
    }

    modeSelect.addEventListener("change", syncModeFields);
    syncModeFields();
    const dateField = form.elements.namedItem("letterDate") as HTMLInputElement;
    if (!dateField.value) dateField.value = today();

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const mode = modeSelect.value as LetterMode;
      if (!LETTER_MODES.some((item) => item.key === mode)) {
        errorList.replaceChildren();
        const item = document.createElement("li");
        const link = document.createElement("a");
        link.href = "#letterMode";
        link.textContent = "Select a valid letter type.";
        item.appendChild(link);
        errorList.appendChild(item);
        errorSummary.hidden = false;
        errorSummary.focus();
        result.hidden = true;
        return;
      }

      const fields: LetterFields = {
        yourName: value("yourName"),
        insurerName: value("insurerName"),
        adjusterName: value("adjusterName"),
        claimNumber: value("claimNumber"),
        vehicleDesc: value("vehicleDesc"),
        dateOfLoss: value("dateOfLoss"),
        letterDate: value("letterDate"),
        correctionDetails: value("correctionDetails"),
        comparablesDetails: value("comparablesDetails"),
        repairSummary: value("repairSummary"),
        dvBasis: value("dvBasis"),
        adjustmentDetails: value("adjustmentDetails"),
      };
      output.value = generateLetter(mode, fields);
      errorSummary.hidden = true;
      result.hidden = false;
      resultHeading.focus();
      trackLetterGenerated(mode);
    });

    document.getElementById("letter-start-over")?.addEventListener("click", () => {
      form.reset();
      dateField.value = today();
      syncModeFields();
      output.value = "";
      errorSummary.hidden = true;
      result.hidden = true;
      copyStatus?.setAttribute("hidden", "");
      modeSelect.focus();
    });

    document.getElementById("copy-letter")?.addEventListener("click", async () => {
      let copied = false;
      try {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(output.value);
          copied = true;
        }
      } catch {
        copied = false;
      }
      if (!copied) {
        output.focus();
        output.select();
        copied = document.execCommand("copy");
      }
      if (copyStatus) {
        copyStatus.hidden = false;
        copyStatus.textContent = copied
          ? "Letter copied to your clipboard."
          : "Automatic copy was blocked. Select the letter text and copy it manually.";
      }
      if (copied) trackLetterCopied(modeSelect.value);
    });

    document.getElementById("print-letter")?.addEventListener("click", () => {
      trackLetterPrinted(modeSelect.value);
      window.print();
    });
  }
</script>

<style>
  .mode-fields {
    border-top: 1px solid var(--color-border);
    margin-top: 22px;
    padding-top: 20px;
  }

  .mode-fields .field + .field { margin-top: 16px; }

  .letter-output {
    min-height: 540px;
    white-space: pre-wrap;
  }

  .checklist-list {
    display: grid;
    gap: 8px;
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
  }

  .checklist-list li {
    align-items: flex-start;
    display: flex;
    gap: 10px;
  }

  .checklist-list input {
    flex: 0 0 auto;
    margin: 2px 0 0;
  }

  .checklist-list label {
    cursor: pointer;
    min-height: var(--touch-target-min);
    padding-top: 8px;
  }

  @media print {
    .evidence-card,
    .disclaimer-box,
    body > footer { display: none !important; }
    .letter-output {
      border: 0;
      min-height: auto;
      overflow: visible;
      resize: none;
    }
  }
</style>
