---
import BaseLayout from "@layouts/BaseLayout.astro";
import ErrorSummary from "@components/ErrorSummary.astro";
import FaqSection from "@components/FaqSection.astro";
import AdSlot from "@components/AdSlot.astro";
import {
  MISMATCH_FIELDS,
  TOTAL_LOSS_AUDIT_CONFIG,
} from "@lib/calculators/total-loss-audit";
import { buildFaqSchema, type FaqItem } from "@lib/seo/faq-schema";

const title = "Totaled Car Value Calculator: What Will Insurance Pay?";
const description =
  "Estimate your total loss payout: your car's value plus tax and fees, minus deductible, salvage and loan payoff. Then check the insurer's valuation report.";
const path = "/calculators/total-loss-offer-audit/";
const insurerRows = Array.from({ length: 4 }, (_, index) => index + 1);
const ownerRows = Array.from({ length: 6 }, (_, index) => index + 1);

const faqs: FaqItem[] = [
  {
    question: "How much will insurance pay for my totaled car?",
    answer:
      "The starting point is the car's actual cash value (ACV): what a similar car was selling for near you just before the crash. Many states then require sales tax and title fees on top. Your deductible comes off if you claim on your own policy, and the salvage value comes off if you keep the car. If you have a loan, the lender is paid first and you get what is left.",
  },
  {
    question: "Is my deductible taken out of a total loss payout?",
    answer:
      "Only when you claim on your own collision or comprehensive coverage. If the other driver's insurer is paying because their driver was at fault, there is no deductible.",
  },
  {
    question: "Does insurance pay sales tax on a totaled car?",
    answer:
      "It depends on your state. Some states require it in writing: Kansas, for example, requires insurers to include the sales tax and title and registration fees needed to buy a comparable car. Other states have no clear rule. Ask your adjuster whether tax and fees are included and check your state insurance department's guidance.",
  },
  {
    question: "What is a projected sold adjustment?",
    answer:
      "Some valuation reports cut each comparable car's asking price by a percentage, on the theory that cars sell for less than they are listed for. It lowers your car's value. Several class-action lawsuits have challenged this adjustment, and courts have ruled both ways, so if your report has one, ask the insurer to show what it is based on.",
  },
  {
    question: "What is a condition adjustment on a valuation report?",
    answer:
      "It compares your car's condition with the condition of the comparable cars, which are usually dealer-ready. If your car is rated below them the value goes down, and if it is rated better it goes up. Check that the condition notes match your car, and send photos or service records if they don't.",
  },
  {
    question: "Can I negotiate a total loss offer?",
    answer:
      "Yes. Point out specific errors (mileage, trim, options, condition) and send your own comparable listings. Many policies also have an appraisal clause that lets each side hire an appraiser, with an umpire settling any difference. Our guide on disputing a total loss valuation walks through it.",
  },
  {
    question: "What if I owe more on my loan than the car is worth?",
    answer:
      "The insurer pays your lender up to the payoff amount, and you owe the rest. GAP coverage, if you bought it, may pay some or all of that difference. Use the estimate above with your loan payoff to see the gap.",
  },
  {
    question: "Is anything I type sent to a server?",
    answer:
      "No. Every number stays in your browser and is never sent to or stored on any server operated by this site.",
  },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://www.fairclaimcalculator.com/" },
      { "@type": "ListItem", position: 2, name: "Calculators", item: "https://www.fairclaimcalculator.com/calculators/" },
      { "@type": "ListItem", position: 3, name: "Totaled Car Value Calculator", item: `https://www.fairclaimcalculator.com${path}` },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Totaled Car Value Calculator",
    url: `https://www.fairclaimcalculator.com${path}`,
    applicationCategory: "FinanceApplication",
    operatingSystem: "Any",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  },
  buildFaqSchema(faqs),
];

const statusOptions = [
  { value: "correct", label: "Correct" },
  { value: "incorrect", label: "Incorrect" },
  { value: "unknown", label: "Not sure" },
  { value: "not_shown", label: "Not shown in report" },
];
---
<BaseLayout title={title} description={description} path={path} structuredData={structuredData}>
  <div class="container">
    <p class="breadcrumb-text"><a href="/">Home</a> / <a href="/calculators/">Calculators</a> / Totaled Car Value</p>
    <h1 class="page-title">Totaled Car Value Calculator: What Will Insurance Pay?</h1>
    <p class="lead">
      When your car is totaled, the insurer pays what it was worth just before the crash, not what
      you paid or what you owe. Start with a quick estimate of your check, then check the insurer's
      valuation for the mistakes that lower it most often.
    </p>
    <ul class="trust-badges">
      <li><span aria-hidden="true">🔒</span> Free, no sign-up</li>
      <li><span aria-hidden="true">🧮</span> Every step of the math shown</li>
      <li><span aria-hidden="true">💾</span> Your numbers stay in your browser</li>
    </ul>

    <div class="calc-card" id="payout">
      <h2>Step 1: Estimate your payout</h2>
      <ErrorSummary id="payout-error-summary" />
      <form id="payout-form" novalidate>
        <div class="form-grid">
          <div class="field">
            <label for="payoutClaimType">Who is paying?</label>
            <select id="payoutClaimType" name="payoutClaimType" aria-describedby="payoutClaimType-hint">
              <option value="first-party">My own insurance</option>
              <option value="third-party">The other driver's insurance</option>
            </select>
            <p class="hint" id="payoutClaimType-hint">No deductible applies when the other driver's insurer pays.</p>
          </div>
          <div class="field">
            <label for="payoutAcv">Car's value in the offer (ACV)</label>
            <input type="number" id="payoutAcv" name="payoutAcv" min="0" step="1" inputmode="decimal" required aria-describedby="payoutAcv-hint" />
            <p class="hint" id="payoutAcv-hint">Dollars, before tax, fees and deductible. Example: 18500.</p>
          </div>
          <div class="field">
            <label for="payoutTaxRate">Sales tax rate (%)</label>
            <input type="number" id="payoutTaxRate" name="payoutTaxRate" min="0" max="20" step="0.01" inputmode="decimal" aria-describedby="payoutTaxRate-hint" />
            <p class="hint" id="payoutTaxRate-hint">Optional. Your state and local rate, if your state requires it to be paid. Example: 6.5.</p>
          </div>
          <div class="field">
            <label for="payoutFees">Title and registration fees</label>
            <input type="number" id="payoutFees" name="payoutFees" min="0" step="1" inputmode="decimal" aria-describedby="payoutFees-hint" />
            <p class="hint" id="payoutFees-hint">Optional. Dollars. Example: 150.</p>
          </div>
          <div class="field" id="payoutDeductibleField">
            <label for="payoutDeductible">Your deductible</label>
            <input type="number" id="payoutDeductible" name="payoutDeductible" min="0" step="1" inputmode="decimal" aria-describedby="payoutDeductible-hint" />
            <p class="hint" id="payoutDeductible-hint">Collision or comprehensive deductible. Example: 500.</p>
          </div>
          <div class="field">
            <label for="payoutLoan">Loan or lease payoff</label>
            <input type="number" id="payoutLoan" name="payoutLoan" min="0" step="1" inputmode="decimal" aria-describedby="payoutLoan-hint" />
            <p class="hint" id="payoutLoan-hint">Optional. Ask your lender for the payoff amount, not the monthly balance.</p>
          </div>
          <div class="field">
            <label for="payoutSalvage">Salvage value if you keep the car</label>
            <input type="number" id="payoutSalvage" name="payoutSalvage" min="0" step="1" inputmode="decimal" aria-describedby="payoutSalvage-hint" />
            <p class="hint" id="payoutSalvage-hint">Leave blank unless you plan to keep the car. The insurer subtracts it.</p>
          </div>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn-primary">Estimate my payout</button>
          <button type="button" class="btn-secondary" id="payout-start-over">Start over</button>
        </div>
      </form>
      <div class="result-box" id="payout-result" hidden>
        <h2 id="payout-result-heading" tabindex="-1">Your estimated payout</h2>
        <p class="payout-headline" id="payout-headline"></p>
        <div class="breakdown" id="payout-breakdown"></div>
        <div id="payout-notes"></div>
        <p class="section-note">
          This is an estimate from the numbers you entered, not what the insurer owes. The next
          step checks whether the car's value itself is right.
        </p>
      </div>
    </div>

    <h2 class="step-heading">Step 2: Check the insurer's valuation</h2>
    <p>
      The car's value is the number that moves your payout most, and valuation reports are where
      most mistakes hide. Enter what the report says and the comparable cars it used.
    </p>
    <div class="calc-card">
      <h2>Audit the valuation report</h2>
      <ErrorSummary id="total-loss-error-summary" />

      <form id="total-loss-form" novalidate>
        <h3 class="section-heading">1. Your vehicle and the insurer's offer</h3>
        <div class="form-grid">
          <div class="field">
            <label for="claimType">Claim type</label>
            <select id="claimType" name="claimType" aria-describedby="claimType-hint">
              <option value="third-party">Another driver's insurer (third-party)</option>
              <option value="first-party">My own insurer (first-party)</option>
            </select>
            <p class="hint" id="claimType-hint">Used only to label your worksheet; it does not change the price statistics.</p>
          </div>
          <div class="field">
            <label for="acv">Insurer's stated ACV / base value</label>
            <input type="number" id="acv" name="acv" min="0" max="10000000" step="1" inputmode="decimal" required aria-describedby="acv-hint" />
            <p class="hint" id="acv-hint">U.S. dollars. Example: 18500. Use the base value before deductible or loan payoff.</p>
          </div>
          <div class="field">
            <label for="subjectYear">Your vehicle's model year</label>
            <input type="number" id="subjectYear" name="subjectYear" min="1886" max="2027" step="1" inputmode="numeric" required aria-describedby="subjectYear-hint" />
            <p class="hint" id="subjectYear-hint">Whole year. Example: 2020.</p>
          </div>
          <div class="field">
            <label for="subjectMileage">Your vehicle's mileage at the loss</label>
            <input type="number" id="subjectMileage" name="subjectMileage" min="0" max="500000" step="1" inputmode="numeric" required aria-describedby="subjectMileage-hint" />
            <p class="hint" id="subjectMileage-hint">Whole miles. Example: 48200.</p>
          </div>
          <div class="field">
            <label for="subjectTrim">Trim / option package</label>
            <input type="text" id="subjectTrim" name="subjectTrim" maxlength="100" aria-describedby="subjectTrim-hint" />
            <p class="hint" id="subjectTrim-hint">Optional. Example: EX-L with Technology Package.</p>
          </div>
          <div class="field">
            <label for="subjectConfiguration">Engine, drivetrain, and body style</label>
            <input type="text" id="subjectConfiguration" name="subjectConfiguration" maxlength="120" aria-describedby="subjectConfiguration-hint" />
            <p class="hint" id="subjectConfiguration-hint">Optional. Example: 2.0L AWD four-door.</p>
          </div>
        </div>

        <h3 class="section-heading">2. Check the valuation-report facts</h3>
        <p class="section-note">
          Mark only what you know. “Incorrect,” “not sure,” and “not shown” become questions to
          verify — never an accusation.
        </p>
        <div class="report-checks">
          {MISMATCH_FIELDS.map((field) => (
            <div class="field report-check">
              <label for={`status_${field.key}`}>{field.label}</label>
              <select id={`status_${field.key}`} name={`status_${field.key}`}>
                {statusOptions.map((option) => <option value={option.value}>{option.label}</option>)}
              </select>
            </div>
          ))}
        </div>

        <h3 class="section-heading">3. Insurer comparables</h3>
        <p class="section-note">
          Add up to four vehicles from the written valuation report. Group comparisons require at
          least two priced comps; fewer than three are labeled as limited.
        </p>
        {insurerRows.map((index) => (
          <fieldset class="comp-card" data-comp-card={`insurer-${index}`}>
            <legend>Insurer comp {index}</legend>
            <div class="form-grid compact-grid">
              <div class="field">
                <label for={`insurer-${index}-value`}>Adjusted value</label>
                <input type="number" id={`insurer-${index}-value`} name={`insurer-${index}-value`} min="0" max="10000000" step="1" inputmode="decimal" aria-describedby={`insurer-${index}-value-hint`} />
                <p class="hint" id={`insurer-${index}-value-hint`}>U.S. dollars from the report.</p>
              </div>
              <div class="field">
                <label for={`insurer-${index}-year`}>Model year</label>
                <input type="number" id={`insurer-${index}-year`} name={`insurer-${index}-year`} min="1886" max="2027" step="1" inputmode="numeric" />
              </div>
              <div class="field">
                <label for={`insurer-${index}-mileage`}>Mileage</label>
                <input type="number" id={`insurer-${index}-mileage`} name={`insurer-${index}-mileage`} min="0" max="500000" step="1" inputmode="numeric" />
              </div>
              <div class="field">
                <label for={`insurer-${index}-distance`}>Distance from you</label>
                <input type="number" id={`insurer-${index}-distance`} name={`insurer-${index}-distance`} min="0" max="5000" step="1" inputmode="numeric" aria-describedby={`insurer-${index}-distance-hint`} />
                <p class="hint" id={`insurer-${index}-distance-hint`}>Miles. Used only as a review question.</p>
              </div>
            </div>
            <details>
              <summary>Comparable-quality details</summary>
              <div class="form-grid compact-grid">
                <div class="field">
                  <label for={`insurer-${index}-trimMatch`}>Exact trim/options match?</label>
                  <select id={`insurer-${index}-trimMatch`} name={`insurer-${index}-trimMatch`}>
                    <option value="unknown">Not sure</option><option value="yes">Yes</option><option value="no">No</option>
                  </select>
                </div>
                <div class="field">
                  <label for={`insurer-${index}-configurationMatch`}>Engine/drivetrain/body match?</label>
                  <select id={`insurer-${index}-configurationMatch`} name={`insurer-${index}-configurationMatch`}>
                    <option value="unknown">Not sure</option><option value="yes">Yes</option><option value="no">No</option>
                  </select>
                </div>
                <div class="field">
                  <label for={`insurer-${index}-listingStatus`}>Listing status</label>
                  <select id={`insurer-${index}-listingStatus`} name={`insurer-${index}-listingStatus`}>
                    <option value="unknown">Not sure</option><option value="active">Active</option><option value="sold">Sold</option><option value="expired">Expired</option>
                  </select>
                </div>
                <div class="field">
                  <label for={`insurer-${index}-listingDate`}>Listing / date checked</label>
                  <input type="date" id={`insurer-${index}-listingDate`} name={`insurer-${index}-listingDate`} />
                </div>
                <div class="field">
                  <label for={`insurer-${index}-sellerType`}>Seller type</label>
                  <select id={`insurer-${index}-sellerType`} name={`insurer-${index}-sellerType`}>
                    <option value="unknown">Not sure</option><option value="dealer">Dealer</option><option value="private">Private party</option>
                  </select>
                </div>
                <div class="field">
                  <label for={`insurer-${index}-conditionMatch`}>Condition compared with yours</label>
                  <select id={`insurer-${index}-conditionMatch`} name={`insurer-${index}-conditionMatch`}>
                    <option value="unknown">Not sure</option><option value="similar">Similar</option><option value="better">Better</option><option value="worse">Worse</option>
                  </select>
                </div>
                <div class="field">
                  <label for={`insurer-${index}-adjustmentsShown`}>Itemized adjustments shown?</label>
                  <select id={`insurer-${index}-adjustmentsShown`} name={`insurer-${index}-adjustmentsShown`}>
                    <option value="unknown">Not sure</option><option value="yes">Yes</option><option value="no">No</option>
                  </select>
                </div>
              </div>
            </details>
          </fieldset>
        ))}

        <h3 class="section-heading">4. Your comparables</h3>
        <p class="section-note">
          Add up to six listings you found. Capture the date and seller type so you can preserve the
          evidence, not just the asking price.
        </p>
        {ownerRows.map((index) => (
          <fieldset class="comp-card" data-comp-card={`owner-${index}`}>
            <legend>Your comp {index}</legend>
            <div class="form-grid compact-grid">
              <div class="field">
                <label for={`owner-${index}-value`}>Asking price</label>
                <input type="number" id={`owner-${index}-value`} name={`owner-${index}-value`} min="0" max="10000000" step="1" inputmode="decimal" aria-describedby={`owner-${index}-value-hint`} />
                <p class="hint" id={`owner-${index}-value-hint`}>U.S. dollars. Asking price is not assumed to equal sale price.</p>
              </div>
              <div class="field">
                <label for={`owner-${index}-year`}>Model year</label>
                <input type="number" id={`owner-${index}-year`} name={`owner-${index}-year`} min="1886" max="2027" step="1" inputmode="numeric" />
              </div>
              <div class="field">
                <label for={`owner-${index}-mileage`}>Mileage</label>
                <input type="number" id={`owner-${index}-mileage`} name={`owner-${index}-mileage`} min="0" max="500000" step="1" inputmode="numeric" />
              </div>
              <div class="field">
                <label for={`owner-${index}-distance`}>Distance from you</label>
                <input type="number" id={`owner-${index}-distance`} name={`owner-${index}-distance`} min="0" max="5000" step="1" inputmode="numeric" />
              </div>
            </div>
            <details>
              <summary>Comparable-quality details</summary>
              <div class="form-grid compact-grid">
                <div class="field">
                  <label for={`owner-${index}-trimMatch`}>Exact trim/options match?</label>
                  <select id={`owner-${index}-trimMatch`} name={`owner-${index}-trimMatch`}>
                    <option value="unknown">Not sure</option><option value="yes">Yes</option><option value="no">No</option>
                  </select>
                </div>
                <div class="field">
                  <label for={`owner-${index}-configurationMatch`}>Engine/drivetrain/body match?</label>
                  <select id={`owner-${index}-configurationMatch`} name={`owner-${index}-configurationMatch`}>
                    <option value="unknown">Not sure</option><option value="yes">Yes</option><option value="no">No</option>
                  </select>
                </div>
                <div class="field">
                  <label for={`owner-${index}-listingStatus`}>Listing status</label>
                  <select id={`owner-${index}-listingStatus`} name={`owner-${index}-listingStatus`}>
                    <option value="unknown">Not sure</option><option value="active">Active</option><option value="sold">Sold</option><option value="expired">Expired</option>
                  </select>
                </div>
                <div class="field">
                  <label for={`owner-${index}-listingDate`}>Listing / date checked</label>
                  <input type="date" id={`owner-${index}-listingDate`} name={`owner-${index}-listingDate`} />
                </div>
                <div class="field">
                  <label for={`owner-${index}-sellerType`}>Seller type</label>
                  <select id={`owner-${index}-sellerType`} name={`owner-${index}-sellerType`}>
                    <option value="unknown">Not sure</option><option value="dealer">Dealer</option><option value="private">Private party</option>
                  </select>
                </div>
                <div class="field">
                  <label for={`owner-${index}-conditionMatch`}>Condition compared with yours</label>
                  <select id={`owner-${index}-conditionMatch`} name={`owner-${index}-conditionMatch`}>
                    <option value="unknown">Not sure</option><option value="similar">Similar</option><option value="better">Better</option><option value="worse">Worse</option>
                  </select>
                </div>
                <div class="field">
                  <label for={`owner-${index}-adjustmentsShown`}>Price adjustment documented?</label>
                  <select id={`owner-${index}-adjustmentsShown`} name={`owner-${index}-adjustmentsShown`}>
                    <option value="unknown">Not sure</option><option value="yes">Yes</option><option value="no">No</option>
                  </select>
                </div>
              </div>
            </details>
          </fieldset>
        ))}

        <div class="form-actions">
          <button type="submit" class="btn-primary">Run My Audit</button>
          <button type="button" class="btn-secondary" id="total-loss-start-over">Start over and delete my answers</button>
        </div>
      </form>

      <section class="result-box" id="total-loss-result" hidden aria-labelledby="total-loss-result-heading">
        <h2 id="total-loss-result-heading" tabindex="-1">Your Audit Results</h2>
        <p class="range" id="total-loss-acv-result">—</p>

        <h3>Possible report mismatches to verify</h3>
        <div id="total-loss-mismatches"></div>

        <h3>Price statistics</h3>
        <div class="stats-grid">
          <section>
            <h4>Insurer comparables</h4>
            <div id="total-loss-insurer-stats"></div>
          </section>
          <section>
            <h4>Your comparables</h4>
            <div id="total-loss-owner-stats"></div>
          </section>
        </div>

        <h3>Internal-consistency questions</h3>
        <div id="total-loss-consistency"></div>

        <h3>Comparable-quality review</h3>
        <p class="section-note">
          These are verification questions, not a score or dollar adjustment. A different year,
          mileage, seller type, or location can matter, but this tool does not pretend to know the
          correct monetary weight.
        </p>
        <div id="total-loss-quality"></div>

        <div class="methodology-note">
          <p><strong>Methodology version {TOTAL_LOSS_AUDIT_CONFIG.version}</strong> — last reviewed {TOTAL_LOSS_AUDIT_CONFIG.reviewedDate}.</p>
          {TOTAL_LOSS_AUDIT_CONFIG.sources.map((source) => <p>{source}</p>)}
          <p><a href="/methodology/">Read the full calculator methodology →</a></p>
        </div>
        <div class="result-actions">
          <button type="button" class="btn-secondary" id="total-loss-print">Print / Save as PDF</button>
        </div>
      </section>
    </div>

    <section class="guide-section">
      <h2>How a total loss payout is calculated</h2>
      <p>
        Every total loss check is built the same way. The amounts differ by state and policy, but
        the order is the same:
      </p>
      <div class="table-wrap">
        <table>
          <thead><tr><th scope="col">Step</th><th scope="col">Example</th></tr></thead>
          <tbody>
            <tr><td>Car's actual cash value (ACV)</td><td>$18,500</td></tr>
            <tr><td>+ Sales tax, if your state requires it (6.5%)</td><td>$1,202.50</td></tr>
            <tr><td>+ Title and registration fees</td><td>$150</td></tr>
            <tr><td>− Deductible (your own policy only)</td><td>−$500</td></tr>
            <tr><td><strong>Settlement</strong></td><td><strong>$19,352.50</strong></td></tr>
            <tr><td>− Paid to your lender (payoff $12,000)</td><td>−$12,000</td></tr>
            <tr><td><strong>Your check</strong></td><td><strong>$7,352.50</strong></td></tr>
          </tbody>
        </table>
      </div>
      <p>
        If you keep the car, the insurer also subtracts its salvage value, what the wreck would have
        sold for at auction. The Washington Insurance Commissioner publishes a
        <a href="https://insurance.wa.gov/insurance-resources/auto-insurance/auto-insurance-claims/how-insurers-calculate-taxes-and-fees-when-your-car-totaled" target="_blank" rel="noopener">worked example</a>
        of the same steps.
      </p>

      <h2>What's inside the valuation report</h2>
      <p>
        Most insurers use a valuation company such as CCC or Mitchell. The report lists your car's
        details, several comparable cars for sale near you, and adjustments that move each one up or
        down to match your car. These are the lines worth reading closely:
      </p>
      <ul>
        <li><strong>Mileage, trim and options.</strong> A wrong trim level or a missing package (leather, navigation, a towing package) is one of the most common errors, and it lowers every comparable.</li>
        <li><strong>Condition adjustment.</strong> Your car's condition is compared with dealer-ready cars. Check that the condition notes match reality, and send photos or service records if they don't.</li>
        <li><strong>Projected sold adjustment.</strong> Some reports cut each comparable's asking price on the theory that cars sell below list price. Several class actions have challenged it, with courts ruling both ways. If you see one, ask what it is based on.</li>
        <li><strong>Comparable cars.</strong> Check that they are the same model, similar year and miles, and reasonably close to you. Far-away or older listings tend to pull the value down.</li>
      </ul>
      <p>
        More detail: <a href="/guides/total-loss/how-insurers-value-a-total-loss-vehicle/">how insurers value a totaled car</a>
        and <a href="/guides/total-loss/common-valuation-report-errors/">common valuation report errors</a>.
      </p>

      <h2>If the offer looks low</h2>
      <ol>
        <li>Ask for the full written valuation report if you only have the offer amount.</li>
        <li>Fix the facts first: mileage, trim, options and condition.</li>
        <li>Find three or more similar cars for sale near you and save the listings. Our <a href="/forms/comparable-vehicles-worksheet/">comparable vehicles worksheet</a> keeps them organized.</li>
        <li>Send a short written response with your evidence. The <a href="/calculators/claim-letter-builder/">claim letter builder</a> drafts it for you.</li>
        <li>If you still disagree, ask about your policy's appraisal clause or contact your state insurance department.</li>
      </ol>
    </section>

    <div class="disclaimer-box">
      <strong>Educational worksheet, not legal advice or an appraisal.</strong>
      The tool organizes facts and arithmetic. It does not interpret a policy, determine market
      value, or tell you what an insurer legally owes. See the <a href="/disclaimer/">full disclaimer</a>.
    </div>

    <FaqSection faqs={faqs} heading="Common questions about total loss payouts" />
    <AdSlot path={path} slot="calculator-after-faq" />

    <h2>More calculators</h2>
    <div class="related-tools">
      <a href="/calculators/settlement-check-breakdown/">Settlement Check Breakdown →</a>
      <a href="/calculators/diminished-value-baseline/">Diminished Value Baseline →</a>
      <a href="/calculators/leased-vehicle-diminished-value/">Leased Vehicle Diminished Value →</a>
      <a href="/calculators/claim-letter-builder/">Claim Letter Builder →</a>
      <a href="/calculators/loss-of-use-reimbursement/">Rental / Loss-of-Use Reimbursement →</a>
      <a href="/calculators/salvage-value/">Salvage / Owner-Retained Value →</a>
      <a href="/calculators/total-loss-threshold-checker/">Is My Car Totaled? →</a>
      <a href="/check-my-offer/">Check My Offer →</a>
    </div>
  </div>
</BaseLayout>

<script>
  import {
    MISMATCH_FIELDS,
    auditSummary,
    evaluateMismatches,
    formatUSD,
    parseOptionalWholeNumber,
    reviewComparableQuality,
    toCents,
    type ComparableVehicle,
    type CompSource,
    type ConditionMatch,
    type ListingStatus,
    type MatchStatus,
    type PriceComp,
    type ReportStatus,
    type SellerType,
  } from "@lib/calculators/total-loss-audit";
  import { trackCalculatorCompleted } from "@lib/analytics/events";

  const form = document.getElementById("total-loss-form") as HTMLFormElement | null;
  const result = document.getElementById("total-loss-result");
  const resultHeading = document.getElementById("total-loss-result-heading");
  const summary = document.getElementById("total-loss-error-summary");
  const summaryList = document.getElementById("total-loss-error-summary-list");

  if (form && result && resultHeading && summary && summaryList) {
    const value = (name: string) =>
      (form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null)?.value ?? "";

    function clearErrors() {
      form!.querySelectorAll<HTMLElement>(".field-error").forEach((wrapper) => wrapper.classList.remove("field-error"));
      form!.querySelectorAll<HTMLElement>(".field-error-message").forEach((message) => message.remove());
      form!.querySelectorAll<HTMLElement>("[aria-invalid='true']").forEach((field) => {
        field.setAttribute("aria-invalid", "false");
        const describedBy = (field.getAttribute("aria-describedby") ?? "")
          .split(/\s+/)
          .filter((id) => id && !id.endsWith("-error"));
        if (describedBy.length) field.setAttribute("aria-describedby", describedBy.join(" "));
        else field.removeAttribute("aria-describedby");
      });
    }

    function markError(fieldId: string, message: string) {
      const field = document.getElementById(fieldId);
      const wrapper = field?.closest(".field");
      if (!field || !wrapper) return;
      wrapper.classList.add("field-error");
      field.setAttribute("aria-invalid", "true");
      const errorId = `${fieldId}-error`;
      const error = document.createElement("p");
      error.id = errorId;
      error.className = "field-error-message";
      error.textContent = `Error: ${message}`;
      wrapper.appendChild(error);
      const describedBy = new Set((field.getAttribute("aria-describedby") ?? "").split(/\s+/).filter(Boolean));
      describedBy.add(errorId);
      field.setAttribute("aria-describedby", [...describedBy].join(" "));
    }

    type FormError = { fieldId: string; message: string };

    function readComps(
      prefix: "insurer" | "owner",
      count: number,
      source: CompSource,
      errors: FormError[],
    ): { prices: PriceComp[]; quality: ComparableVehicle[] } {
      const prices: PriceComp[] = [];
      const quality: ComparableVehicle[] = [];

      for (let index = 1; index <= count; index += 1) {
        const base = `${prefix}-${index}`;
        const priceRaw = value(`${base}-value`);
        const numericFields = ["year", "mileage", "distance"];
        const hasAny =
          priceRaw !== "" ||
          numericFields.some((name) => value(`${base}-${name}`) !== "") ||
          value(`${base}-listingDate`) !== "" ||
          ["trimMatch", "configurationMatch", "listingStatus", "sellerType", "conditionMatch", "adjustmentsShown"]
            .some((name) => value(`${base}-${name}`) !== "unknown");

        if (!hasAny) continue;
        if (priceRaw === "") {
          errors.push({ fieldId: `${base}-value`, message: `Enter a price for ${source === "insurer" ? "insurer" : "your"} comp ${index}, or clear the rest of that comp.` });
          continue;
        }

        const price = toCents(priceRaw, { label: `${source === "insurer" ? "Insurer" : "Your"} comp ${index} price` });
        if (price.error) errors.push({ fieldId: `${base}-value`, message: price.error });

        const year = parseOptionalWholeNumber(value(`${base}-year`), { label: `Comp ${index} year`, max: 2027 });
        const mileage = parseOptionalWholeNumber(value(`${base}-mileage`), { label: `Comp ${index} mileage`, max: 500000 });
        const distance = parseOptionalWholeNumber(value(`${base}-distance`), { label: `Comp ${index} distance`, max: 5000 });
        if (year.error) errors.push({ fieldId: `${base}-year`, message: year.error });
        if (mileage.error) errors.push({ fieldId: `${base}-mileage`, message: mileage.error });
        if (distance.error) errors.push({ fieldId: `${base}-distance`, message: distance.error });

        prices.push({ valueCents: price.value });
        quality.push({
          id: `${source === "insurer" ? "Insurer" : "Your"} comp ${index}`,
          source,
          year: year.value,
          mileage: mileage.value,
          distanceMiles: distance.value,
          trimMatch: value(`${base}-trimMatch`) as MatchStatus,
          configurationMatch: value(`${base}-configurationMatch`) as MatchStatus,
          listingStatus: value(`${base}-listingStatus`) as ListingStatus,
          listingDate: value(`${base}-listingDate`),
          sellerType: value(`${base}-sellerType`) as SellerType,
          conditionMatch: value(`${base}-conditionMatch`) as ConditionMatch,
          adjustmentsShown: value(`${base}-adjustmentsShown`) as MatchStatus,
        });
      }
      return { prices, quality };
    }

    function renderStats(container: HTMLElement | null, stats: ReturnType<typeof auditSummary>["insurerStats"]) {
      if (!container) return;
      container.replaceChildren();
      if (!stats) {
        const p = document.createElement("p");
        p.textContent = "No priced comparables entered.";
        container.appendChild(p);
        return;
      }
      if (!stats.canCompareGroup) {
        const p = document.createElement("p");
        p.className = "warning-note";
        p.textContent = "One comp entered. Add at least one more before treating it as a group or comparing its range with the ACV.";
        container.appendChild(p);
        return;
      }
      const rows = [
        ["Comps counted", String(stats.count)],
        ["Mean", formatUSD(stats.meanCents)],
        ["Median", formatUSD(stats.medianCents)],
        ["Range", `${formatUSD(stats.minCents)} – ${formatUSD(stats.maxCents)}`],
      ];
      const breakdown = document.createElement("div");
      breakdown.className = "breakdown";
      rows.forEach(([labelText, numberText]) => {
        const row = document.createElement("div");
        row.className = "breakdown-row";
        const label = document.createElement("span");
        label.textContent = labelText;
        const number = document.createElement("span");
        number.textContent = numberText;
        row.append(label, number);
        breakdown.appendChild(row);
      });
      const confidence = document.createElement("p");
      confidence.className = "confidence-label";
      confidence.textContent =
        stats.confidence === "limited"
          ? "Limited sample: only two priced comparables."
          : "Three or more priced comparables provide more context, but match quality still matters.";
      container.append(breakdown, confidence);
      if (stats.outlierIndexes.length) {
        const note = document.createElement("p");
        note.className = "warning-note";
        note.textContent = `${stats.outlierIndexes.length} possible outlier(s): more than 20% from this group's median. This is a review heuristic, not an exclusion rule.`;
        container.appendChild(note);
      }
    }

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      clearErrors();
      const errors: FormError[] = [];

      if (value("acv") === "") errors.push({ fieldId: "acv", message: "Insurer's stated ACV is required." });
      const acv = toCents(value("acv"), { label: "Insurer's stated ACV" });
      if (acv.error) errors.push({ fieldId: "acv", message: acv.error });

      if (value("subjectYear") === "") errors.push({ fieldId: "subjectYear", message: "Your vehicle's model year is required for the quality review." });
      if (value("subjectMileage") === "") errors.push({ fieldId: "subjectMileage", message: "Your vehicle's mileage is required for the quality review." });
      const subjectYear = parseOptionalWholeNumber(value("subjectYear"), { label: "Your vehicle's year", max: 2027 });
      const subjectMileage = parseOptionalWholeNumber(value("subjectMileage"), { label: "Your vehicle's mileage", max: 500000 });
      if (subjectYear.error) errors.push({ fieldId: "subjectYear", message: subjectYear.error });
      if (subjectMileage.error) errors.push({ fieldId: "subjectMileage", message: subjectMileage.error });

      const insurer = readComps("insurer", 4, "insurer", errors);
      const owner = readComps("owner", 6, "owner", errors);

      if (errors.length) {
        summaryList.replaceChildren();
        errors.forEach((error) => {
          markError(error.fieldId, error.message);
          const item = document.createElement("li");
          const link = document.createElement("a");
          link.href = `#${error.fieldId}`;
          link.textContent = error.message;
          link.addEventListener("click", (clickEvent) => {
            clickEvent.preventDefault();
            document.getElementById(error.fieldId)?.focus();
          });
          item.appendChild(link);
          summaryList.appendChild(item);
        });
        summary.hidden = false;
        summary.focus();
        result.hidden = true;
        return;
      }

      summary.hidden = true;
      const statuses: Partial<Record<string, ReportStatus>> = {};
      MISMATCH_FIELDS.forEach((field) => {
        statuses[field.key] = value(`status_${field.key}`) as ReportStatus;
      });
      const mismatches = evaluateMismatches(statuses);
      const audit = auditSummary({
        acvCents: acv.value,
        insurerComps: insurer.prices,
        userComps: owner.prices,
      });
      const quality = reviewComparableQuality(
        {
          year: subjectYear.value,
          mileage: subjectMileage.value,
          trim: value("subjectTrim"),
          configuration: value("subjectConfiguration"),
        },
        [...insurer.quality, ...owner.quality],
      );

      const acvResult = document.getElementById("total-loss-acv-result");
      if (acvResult) acvResult.textContent = `Insurer's stated ACV: ${formatUSD(audit.acvCents)}`;

      const mismatchBox = document.getElementById("total-loss-mismatches");
      if (mismatchBox) {
        mismatchBox.replaceChildren();
        if (!mismatches.length) {
          const p = document.createElement("p");
          p.className = "success-note";
          p.textContent = "No checklist items flagged — you marked every report field as correct.";
          mismatchBox.appendChild(p);
        } else {
          const list = document.createElement("ul");
          list.className = "flag-list";
          mismatches.forEach((mismatch) => {
            const item = document.createElement("li");
            const strong = document.createElement("strong");
            strong.textContent = `${mismatch.label}. `;
            item.append(strong, document.createTextNode(mismatch.note));
            list.appendChild(item);
          });
          mismatchBox.appendChild(list);
        }
      }

      renderStats(document.getElementById("total-loss-insurer-stats"), audit.insurerStats);
      renderStats(document.getElementById("total-loss-owner-stats"), audit.userStats);

      const consistency = document.getElementById("total-loss-consistency");
      if (consistency) {
        consistency.replaceChildren();
        const notes = [audit.acvVsInsurerFlag, audit.acvVsUserNote].filter((note): note is string => Boolean(note));
        if (!notes.length) {
          const p = document.createElement("p");
          p.textContent = "No group-level consistency question was generated. This does not mean every comp is a good match; review quality below.";
          consistency.appendChild(p);
        } else {
          notes.forEach((noteText) => {
            const p = document.createElement("p");
            p.className = "warning-note";
            p.textContent = noteText;
            consistency.appendChild(p);
          });
        }
      }

      const qualityBox = document.getElementById("total-loss-quality");
      if (qualityBox) {
        qualityBox.replaceChildren();
        if (!quality.length) {
          const p = document.createElement("p");
          p.textContent = "No comparables entered, so there is no quality review yet.";
          qualityBox.appendChild(p);
        } else {
          quality.forEach((review) => {
            const section = document.createElement("section");
            section.className = "quality-review";
            const heading = document.createElement("h4");
            heading.textContent = review.compId;
            const list = document.createElement("ul");
            list.className = "quality-list";
            review.questions.forEach((question) => {
              const item = document.createElement("li");
              item.textContent = question.text;
              list.appendChild(item);
            });
            section.append(heading, list);
            qualityBox.appendChild(section);
          });
        }
      }

      trackCalculatorCompleted("total_loss");
      result.hidden = false;
      resultHeading.focus();
    });

    document.getElementById("total-loss-start-over")?.addEventListener("click", () => {
      form.reset();
      clearErrors();
      summary.hidden = true;
      result.hidden = true;
      (document.getElementById("acv") as HTMLInputElement | null)?.focus();
    });
    document.getElementById("total-loss-print")?.addEventListener("click", () => window.print());
  }
</script>

<script>
  // Step 1: quick payout estimate. Reuses the tested settlement waterfall.
  import { calculateSettlementBreakdown, formatUSD, toCents } from "@lib/calculators/settlement-breakdown";
  import { trackCalculatorCompleted } from "@lib/analytics/events";

  const payoutForm = document.getElementById("payout-form") as HTMLFormElement | null;
  const payoutResult = document.getElementById("payout-result");
  const payoutHeading = document.getElementById("payout-result-heading");
  const payoutHeadline = document.getElementById("payout-headline");
  const payoutBreakdown = document.getElementById("payout-breakdown");
  const payoutNotes = document.getElementById("payout-notes");
  const payoutErrors = document.getElementById("payout-error-summary");
  const payoutErrorList = document.getElementById("payout-error-summary-list");
  const claimTypeSelect = document.getElementById("payoutClaimType") as HTMLSelectElement | null;
  const deductibleField = document.getElementById("payoutDeductibleField");

  function syncDeductible() {
    if (deductibleField && claimTypeSelect) deductibleField.hidden = claimTypeSelect.value === "third-party";
  }
  claimTypeSelect?.addEventListener("change", syncDeductible);
  syncDeductible();

  if (payoutForm && payoutResult && payoutHeading && payoutHeadline && payoutBreakdown && payoutNotes && payoutErrors && payoutErrorList) {
    const value = (name: string) => (payoutForm.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null)?.value ?? "";

    payoutForm.addEventListener("submit", (event) => {
      event.preventDefault();
      const errors: { id: string; message: string }[] = [];
      const money = (id: string, label: string) => {
        const res = toCents(value(id), { label });
        if (res.error) errors.push({ id, message: res.error });
        return res.value;
      };

      if (value("payoutAcv") === "") errors.push({ id: "payoutAcv", message: "Enter the car's value from the offer." });
      const acv = money("payoutAcv", "Car's value");
      const fees = money("payoutFees", "Title and registration fees");
      const deductible = money("payoutDeductible", "Deductible");
      const loan = money("payoutLoan", "Loan or lease payoff");
      const salvage = money("payoutSalvage", "Salvage value");
      const rateRaw = value("payoutTaxRate");
      const rate = rateRaw === "" ? 0 : Number(rateRaw);
      if (Number.isNaN(rate) || rate < 0 || rate > 20) errors.push({ id: "payoutTaxRate", message: "Sales tax rate must be a number from 0 to 20." });

      payoutErrorList.replaceChildren();
      if (errors.length) {
        errors.forEach((err) => {
          const li = document.createElement("li");
          const a = document.createElement("a");
          a.href = `#${err.id}`;
          a.textContent = err.message;
          li.appendChild(a);
          payoutErrorList.appendChild(li);
        });
        payoutErrors.hidden = false;
        payoutErrors.focus();
        payoutResult.hidden = true;
        return;
      }
      payoutErrors.hidden = true;

      const tax = Math.round((acv * rate) / 100);
      const claimType = value("payoutClaimType") === "third-party" ? "third-party" : "first-party";
      const result = calculateSettlementBreakdown({
        acvCents: acv,
        taxFeesCents: tax + fees,
        claimType,
        deductibleCents: deductible,
        hasLoan: loan > 0,
        loanPayoffCents: loan,
        retainingSalvage: salvage > 0,
        salvageDeductionCents: salvage,
      });

      payoutBreakdown.replaceChildren();
      payoutNotes.replaceChildren();
      const row = (label: string, amount: string, strong = false) => {
        const div = document.createElement("div");
        div.className = "breakdown-row" + (strong ? " breakdown-total" : "");
        const l = document.createElement("span");
        l.textContent = label;
        const r = document.createElement("span");
        r.textContent = amount;
        div.append(l, r);
        payoutBreakdown.appendChild(div);
      };
      row("Car's value (ACV)", formatUSD(acv));
      if (tax > 0) row(`Sales tax (${rate}%)`, formatUSD(tax));
      if (fees > 0) row("Title and registration fees", formatUSD(fees));
      if (claimType === "first-party" && deductible > 0) row("Deductible", `−${formatUSD(deductible)}`);
      row("Settlement", formatUSD(result.grossSettlementCents), true);
      if (salvage > 0) row("Salvage value (you keep the car)", `−${formatUSD(salvage)}`);
      if (loan > 0) row("Paid to your lender", `−${formatUSD(result.netToLienholderCents)}`);
      row("Your check", formatUSD(result.netToOwnerCents), true);

      payoutHeadline.textContent = loan > 0
        ? `About ${formatUSD(result.netToOwnerCents)} to you and ${formatUSD(result.netToLienholderCents)} to your lender.`
        : `About ${formatUSD(result.netToOwnerCents)} to you.`;

      const note = (text: string, cls = "section-note") => {
        const p = document.createElement("p");
        p.className = cls;
        p.textContent = text;
        payoutNotes.appendChild(p);
      };
      if (result.grossSettlementFlag) note(result.grossSettlementFlag, "warning-note");
      if (result.loanShortfallCents > 0) {
        note(`You would still owe your lender about ${formatUSD(result.loanShortfallCents)}. GAP coverage, if you have it, may pay some or all of this.`, "warning-note");
      }
      if (rateRaw === "") note("Tip: many states require the insurer to add sales tax. Add your rate to see the difference.");

      trackCalculatorCompleted("total_loss_payout");
      payoutResult.hidden = false;
      payoutHeading.focus();
    });

    document.getElementById("payout-start-over")?.addEventListener("click", () => {
      payoutForm.reset();
      syncDeductible();
      payoutErrors.hidden = true;
      payoutResult.hidden = true;
    });
  }
</script>

