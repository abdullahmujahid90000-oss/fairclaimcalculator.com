---
import BaseLayout from "@layouts/BaseLayout.astro";

const title = "Privacy Policy | FairClaimCalculator";
const description =
  "What FairClaimCalculator collects (consent-gated analytics only, never calculator entries), what it doesn't, and your privacy choices.";
const path = "/privacy/";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://www.fairclaimcalculator.com/" },
      { "@type": "ListItem", position: 2, name: "Privacy Policy", item: `https://www.fairclaimcalculator.com${path}` },
    ],
  },
];
---
<BaseLayout title={title} description={description} path={path} structuredData={structuredData}>
  <div class="container">
    <p class="breadcrumb-text"><a href="/">Home</a> / Privacy Policy</p>
    <h1 class="page-title">Privacy Policy</h1>
    <p class="lead">Last reviewed: 2026-08-01.</p>

    <div class="calc-card">
      <h2>Calculator entries</h2>
      <p>
        Every calculator on this site runs entirely in your browser using client-side JavaScript.
        The vehicle details, dollar figures, comparable listings, and letter text you type into a
        calculator are processed on your device only. They are not transmitted to, or stored on, any
        server operated by this site. Reloading or closing the page clears them.
      </p>

      <h2 class="section-heading">What this site currently collects</h2>
      <p>
        This site uses Google Analytics 4 to understand aggregate traffic — which pages get visited,
        roughly how many people visit, and general device/location information (city-level, derived
        from IP address; Google does not receive your calculator inputs). It runs only if you accept
        it in the cookie banner or below — see "Your privacy choices." It never runs on what you type
        into a calculator: that data is never sent to Google or to any server, by us or by the
        analytics script, in any circumstance.
      </p>
      <p>
        No advertising scripts and no third-party trackers beyond Google Analytics run on this site.
        Your web browser and any network in between (such as your ISP) may still see standard
        technical information — like your IP address and browser type — simply because that is how
        the web works; this site does not separately collect or store that information itself. Our
        hosting provider may keep its own standard server logs; see GitHub's own privacy
        documentation for how GitHub Pages hosting works. Google's use of Analytics data is governed
        by <a href="https://policies.google.com/privacy" target="_blank" rel="noopener">Google's Privacy Policy</a>.
      </p>

      <h2 class="section-heading">Cookies</h2>
      <p>
        This site sets a cookie of its own only to remember your Accept/Reject choice below (stored
        in your browser's local storage, not a tracking cookie). If you accept analytics, Google
        Analytics sets its own cookies to distinguish repeat visits — those are not set until you
        accept. Anything else your browser stores locally (such as evidence-checklist checkbox
        states while a page is open) stays in your browser and is not read by this site's server.
      </p>

      <h2 class="section-heading" id="choices">Your privacy choices</h2>
      <p>
        Use the button below to open the cookie preference banner at any time and accept or reject
        analytics. Your choice is remembered in your browser; nothing is sent to Google Analytics
        until you accept, and you can withdraw acceptance the same way at any time.
      </p>
      <p>
        <button type="button" class="btn-secondary" data-open-cookie-prefs>Manage cookie preferences</button>
      </p>
      <p>
        No advertising currently runs on this site, so there is no ad-related consent to manage yet.
        If that changes, this section and the <a href="/advertising-disclosure/">advertising
        disclosure</a> will be updated to describe exactly what runs and how to control it, before
        any ad request is ever made.
      </p>

      <h2 class="section-heading">Children's privacy</h2>
      <p>This site is not directed to children and does not knowingly collect information from children.</p>

      <h2 class="section-heading">Changes to this policy</h2>
      <p>
        If what this site collects or runs changes, this page will be updated and its reviewed date
        above will change. Material changes will be reflected here before they take effect.
      </p>

      <h2 class="section-heading">Contact</h2>
      <p>Questions about this policy can be sent through the <a href="/contact/">contact page</a>.</p>
    </div>
  </div>
</BaseLayout>
