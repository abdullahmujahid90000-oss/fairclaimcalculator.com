---
import BaseLayout from "@layouts/BaseLayout.astro";
import ClusterHubList from "@components/ClusterHubList.astro";
import { clusterHubSchema } from "@lib/seo/hub-schema";

const title = "Totaled Car Guides: Value, Thresholds and Disputes";
const description =
  "Is your car totaled, what is it worth and how do you push back on a low offer? Guides, calculators and templates for every step of a total loss claim.";
const path = "/guides/total-loss/";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://www.fairclaimcalculator.com/" },
      { "@type": "ListItem", position: 2, name: "Guides", item: "https://www.fairclaimcalculator.com/guides/" },
      { "@type": "ListItem", position: 3, name: "Totaled cars", item: `https://www.fairclaimcalculator.com${path}` },
    ],
  },
  clusterHubSchema("total-loss", "Totaled car guides", description, path),
];
---
<BaseLayout title={title} description={description} path={path} structuredData={structuredData}>
  <div class="container hub-container">
    <p class="breadcrumb-text"><a href="/">Home</a> / <a href="/guides/">Guides</a> / Totaled cars</p>
    <h1 class="page-title">Totaled Car Guides</h1>
    <p class="lead">
      When an insurer says your car is a total loss, three questions follow: was it really totaled,
      is the offer fair, and what happens to the loan and the car itself? Everything on this page
      answers one of them, with the state law, the math and a template where you need one.
    </p>

    <h2>Where to start</h2>
    <ul class="start-list">
      <li>
        <strong>Not sure yet whether the car is totaled?</strong> Run the repair estimate and the car's
        value through the <a href="/calculators/total-loss-threshold-checker/">Is My Car Totaled?
        calculator</a>, then read your state's rule in the
        {" "}<a href="/guides/total-loss/state-total-loss-threshold-laws/">total loss threshold table</a>.
        About half the states set a percentage in law; the rest leave the call to the insurer.
      </li>
      <li>
        <strong>Have an offer in hand?</strong> Read
        {" "}<a href="/guides/total-loss/how-insurers-value-a-total-loss-vehicle/">how insurers value a totaled
        car</a>, then check the report line by line with the
        {" "}<a href="/calculators/total-loss-offer-audit/">totaled car value calculator</a>. Wrong mileage,
        a missing option or a lower trim are common, and each one lowers the payout.
      </li>
      <li>
        <strong>Think the offer is too low?</strong> Gather comparable listings, then follow
        {" "}<a href="/guides/total-loss/how-to-dispute-a-total-loss-valuation/">the dispute guide</a> and send
        the <a href="/forms/total-loss-valuation-dispute-letter/">dispute letter template</a>.
      </li>
      <li>
        <strong>Owe more than the car is worth, or want to keep it?</strong> The
        {" "}<a href="/calculators/gap-shortfall/">gap calculator</a> shows the shortfall, and the
        {" "}<a href="/calculators/salvage-value/">salvage value calculator</a> shows what keeping the car costs you.
      </li>
    </ul>
    <p>
      Every guide cites its sources next to the claims they support and says what it can't tell you.
      None of this is legal advice: for a large or disputed claim, your state insurance department, an
      independent appraiser or a licensed attorney can look at your actual policy.
    </p>

    <ClusterHubList clusterId="total-loss" />
  </div>
</BaseLayout>

<style>
  .hub-container { max-width: 900px; }
  .start-list li { margin-bottom: 10px; }
</style>
