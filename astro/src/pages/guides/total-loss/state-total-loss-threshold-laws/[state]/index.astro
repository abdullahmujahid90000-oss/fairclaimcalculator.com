---
import GuideLayout from "@layouts/GuideLayout.astro";
import FaqSection from "@components/FaqSection.astro";
import {
  STATE_THRESHOLDS,
  slugifyState,
  type StateThreshold,
} from "@lib/calculators/total-loss-threshold";
import { getWorkedExample, getNeighborComparisons, getCrossBorderScenario } from "@lib/content/state-threshold-copy";
import { getStateLawFacts, THRESHOLD_FACTS_CHECKED, type LawKind } from "@lib/content/state-threshold-facts";
import { buildFaqSchema, type FaqItem } from "@lib/seo/faq-schema";
import { isNoindexThresholdStatePage } from "@lib/seo/indexing.mjs";

export function getStaticPaths() {
  return STATE_THRESHOLDS.map((entry) => ({
    params: { state: slugifyState(entry.state) },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: StateThreshold };
const facts = getStateLawFacts(entry.state);
const slug = slugifyState(entry.state);
const path = `/guides/total-loss/state-total-loss-threshold-laws/${slug}/`;
const st = entry.state;
const isPct = entry.type === "percentage";
const pct = entry.thresholdPct as number;
// Whole dollars on these pages; cents add nothing to an illustration.
const usd = (cents: number) => (cents / 100).toLocaleString("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 0 });
// "an Ohio example", "a Texas example".
const aOrAn = /^[AEIOU]/.test(st) ? "an" : "a";

const longDate = (d: string) =>
  d.length === 4
    ? d
    : new Date(`${d}T12:00:00Z`).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" });
const checkedLong = longDate(THRESHOLD_FACTS_CHECKED);

// Primary phrase for every state page: "[state] total loss threshold".
const title = entry.insurerFloor
  ? `${st} Total Loss Threshold: ${pct}% Rule (2026)`
  : isPct
    ? `${st} Total Loss Threshold: ${pct}% Rule Explained`
    : `${st} Total Loss Threshold: No Set Percentage`;

const descriptionOptions = isPct
  ? [
      `${st}'s total loss threshold is ${pct}% under ${facts.cite.name}. What it covers, the exceptions, a worked example and what to do next.`,
      `${st}'s total loss threshold is ${pct}%. What the law covers, the exceptions, a worked example and what to do next.`,
    ]
  : [
      `${st} sets no fixed total loss percentage. How totaled cars are decided under ${facts.cite.name}, a worked example and next steps.`,
      `${st} sets no fixed total loss percentage. How totaled cars are decided there, a worked example and what to do next.`,
    ];
const description = descriptionOptions.find((d) => d.length <= 160) ?? descriptionOptions[descriptionOptions.length - 1];

const h1 = `${st} Total Loss Threshold`;

const kindSentence: Record<LawKind, string> = {
  title: "It is a title rule, so it does not stop an insurer from totaling a car sooner.",
  insurer: "It limits when the insurer may declare a total loss.",
  both: "It affects both the title brand and how the insurer handles the claim.",
};

// Lead: answer first, in this state's own words (first sentence of the law summary).
const firstSentence = facts.lawSays.match(/^.*?[.!?](\s|$)/)?.[0].trim() ?? facts.lawSays;
const saysNoPct = /no (total-loss |damage |fixed )?percentage|sets no|no statutory damage percentage|could not find a damage percentage/i.test(firstSentence);
const summary = isPct
  ? `${st}'s total loss threshold is ${pct}%. ${firstSentence}`
  : saysNoPct
    ? firstSentence
    : `${st} sets no total loss percentage. ${firstSentence}`;

const ex = getWorkedExample(entry);
const halfway = Math.round((ex.lineCents + ex.formulaLineCents) / 2 / 2500) * 2500;

const neighbors = getNeighborComparisons(entry, STATE_THRESHOLDS);
const crossBorder = getCrossBorderScenario(entry, STATE_THRESHOLDS);
const neighborList = neighbors.map((n) => {
  const s2 = STATE_THRESHOLDS.find((x) => x.state === n.state) as StateThreshold;
  return { state: n.state, short: s2.type === "percentage" ? `${s2.thresholdPct}%` : s2.basis === "formula" ? "formula-style test" : "no percentage" };
});

const calculatorHref = `/calculators/total-loss-threshold-checker/?state=${encodeURIComponent(st)}`;
const accidentHref = `/guides/accident-reporting/${slug}/`;
const latestEnacted = facts.changes.find((c) => c.status === "enacted");

const faqs: FaqItem[] = [
  {
    question: `What is the total loss threshold in ${st}?`,
    answer: isPct ? `${pct}%. ${facts.lawSays}` : saysNoPct ? facts.lawSays : `${st} has no fixed percentage. ${facts.lawSays}`,
  },
  ...(entry.insurerFloor
    ? [
        {
          question: `Can an insurer total my car below ${pct}% in ${st}?`,
          answer: `Generally not. Below ${pct}% the insurer has to pay for repairs unless you ask for a total loss in writing, which you can do once damage reaches 75%.`,
        },
      ]
    : []),
  {
    question: `Can I keep my totaled car in ${st}?`,
    answer: facts.keeping,
  },
];
if (latestEnacted) {
  faqs.push({
    question: `Has ${st}'s total loss law changed recently?`,
    answer: `Yes. ${longDate(latestEnacted.date)}: ${latestEnacted.text}`,
  });
}
if (facts.listsSay) {
  faqs.push({ question: `Why do websites give different answers for ${st}?`, answer: facts.listsSay });
}

const datasetLd = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  name: `${st} total loss threshold law`,
  description: `${st}'s rule for when a damaged car is a total loss or must get a salvage title, with the statute citation and recent changes. Checked ${THRESHOLD_FACTS_CHECKED}.`,
  url: `https://www.fairclaimcalculator.com${path}`,
  dateModified: THRESHOLD_FACTS_CHECKED,
  creator: { "@type": "Organization", name: "FairClaimCalculator Editorial Team" },
  spatialCoverage: { "@type": "Place", name: `${st}, United States` },
  isBasedOn: facts.cite.url,
};

const structuredData = [buildFaqSchema(faqs), datasetLd];

const host = (u: string) => new URL(u).hostname.replace(/^www\./, "");
const link = (l: { name: string; url: string }) =>
  `${l.name} (<a href="${l.url}" target="_blank" rel="noopener">${host(l.url)}</a>)`;
const sources = [link(facts.cite), link(facts.titleAgency), link(facts.regulator), ...facts.changes.map((c) => link(c.source))].filter(
  (v, i, a) => a.indexOf(v) === i,
);
---
<GuideLayout
  glossaryLink={false}
  title={title}
  description={description}
  path={path}
  h1={h1}
  cluster={{ name: "Total Loss Threshold by State", href: "/guides/total-loss/state-total-loss-threshold-laws/" }}
  publishedDate="2026-08-16"
  reviewedDate={THRESHOLD_FACTS_CHECKED}
  summary={summary}
  sources={sources}
  relatedLinks={[
    { label: `Check your numbers for ${st}`, href: calculatorHref },
    { label: "Total loss threshold in every state", href: "/guides/total-loss/state-total-loss-threshold-laws/" },
    { label: "Recent total loss threshold changes", href: "/guides/total-loss/total-loss-threshold-changes/" },
    { label: `Reporting a car accident in ${st}`, href: accidentHref },
    { label: "Keeping a totaled car and salvage titles", href: "/guides/total-loss/owner-retained-total-loss-and-salvage-titles/" },
  ]}
  structuredData={structuredData}
  noindex={isNoindexThresholdStatePage(path)}
>
  <div class="example-box quick-answer">
    <p><strong>Quick answer</strong></p>
    <ul>
      <li>
        <strong>Rule:</strong>
        {isPct
          ? entry.insurerFloor
            ? ` ${pct}% of the car's value, and the insurer can't total it sooner unless you ask.`
            : ` ${pct}% of the car's value.`
          : " no fixed percentage in the law."}
      </li>
      {facts.measuredAgainst && <li><strong>Measured against:</strong> {facts.measuredAgainst}.</li>}
      <li><strong>Law:</strong> {facts.cite.name}.</li>
      <li><strong>Checked:</strong> {checkedLong}.</li>
    </ul>
  </div>

  {facts.check === "unconfirmed" && (
    <div class="limits-note">
      <strong>We could not confirm {st}'s rule in the official text.</strong> What follows is our best
      reading of the sources we could check. Confirm it with the {facts.regulator.name} before you rely on it.
    </div>
  )}

  <h2>What {st} law says</h2>
  <p>{facts.lawSays}</p>
  <p>{kindSentence[facts.kind]}</p>

  {facts.details.length > 0 && (
    <>
      <h2>Details that change the answer in {st}</h2>
      <ul>
        {facts.details.map((d) => <li>{d}</li>)}
      </ul>
    </>
  )}

  <h2>{aOrAn === "an" ? "An" : "A"} {st} example</h2>
  <div class="example-box">
    {isPct ? (
      <p>
        A {usd(ex.acvCents)} car crosses {st}'s {pct}% line at <strong>{usd(ex.lineCents)}</strong> of repairs.
        {entry.insurerFloor
          ? ` Below that the insurer generally pays to fix it; from ${usd(Math.ceil(ex.acvCents * 0.75))} (75%) you may ask for a total loss in writing.`
          : ex.formulaLineCents < ex.lineCents
            ? ` With a ${usd(ex.salvageCents as number)} wreck value, an insurer may pay it out from ${usd(ex.formulaLineCents)}, so a ${usd(halfway)} estimate could be totaled while still under the line.`
            : ` That comes before the ${usd(ex.formulaLineCents)} point where repairs plus a ${usd(ex.salvageCents as number)} wreck value would equal the car's value.`}
      </p>
    ) : (
      <p>
        A {usd(ex.acvCents)} car with a {usd(ex.salvageCents as number)} wreck value is usually totaled
        from <strong>{usd(ex.lineCents)}</strong> of repairs, where repairs plus salvage equal its value.
      </p>
    )}
    <p><a href={calculatorHref}>Try your own numbers for {st}</a>.</p>
  </div>

  <h2>Keeping a totaled car in {st}</h2>
  <p>{facts.keeping}</p>
  <p>
    Title brands used in {st}: {facts.brands.join(", ")}. Where to start:
    {" "}<a href={facts.titleAgency.url} target="_blank" rel="noopener">{facts.titleAgency.name}</a>.
  </p>

  {facts.changes.length > 0 && (
    <>
      <h2>Recent changes in {st}</h2>
      <ul>
        {facts.changes.map((c) => (
          <li>
            <strong>{longDate(c.date)}{c.status === "failed" ? " (did not pass)" : ""}:</strong> {c.text}{" "}
            <a href={c.source.url} target="_blank" rel="noopener">Source</a>
          </li>
        ))}
      </ul>
    </>
  )}

  {facts.listsSay && (
    <>
      <h2>Where other lists get {st} wrong</h2>
      <p>{facts.listsSay}</p>
    </>
  )}

  <h2>{st} and its neighbors</h2>
  {neighborList.length > 0 ? (
    <p>
      {st} borders{" "}
      {neighborList.map((n, i) => (
        <>
          {i > 0 && (i === neighborList.length - 1 ? " and " : ", ")}
          <a href={`/guides/total-loss/state-total-loss-threshold-laws/${slugifyState(n.state)}/`}>{n.state}</a> ({n.short})
        </>
      ))}.
      {crossBorder && ` ${crossBorder}`}
    </p>
  ) : (
    <p>{st} has no land border with another state, so its own rule nearly always applies.</p>
  )}

  <h2>Who to contact in {st}</h2>
  <p>
    Complaints about how an insurer handled your claim go to the
    {" "}<a href={facts.regulator.url} target="_blank" rel="noopener">{facts.regulator.name}</a>
    {" "}(<a href="/guides/claim-process/filing-a-complaint-with-your-state-insurance-department/">how to file</a>).
    For a disputed or high-value claim, {aOrAn} {st}-licensed attorney can say how {facts.cite.name} applies to you.
  </p>

  <FaqSection faqs={faqs} />
</GuideLayout>

<style>
  .quick-answer ul { margin: 6px 0 0; padding-left: 20px; }
  .table-wrap { overflow-x: auto; }
</style>
