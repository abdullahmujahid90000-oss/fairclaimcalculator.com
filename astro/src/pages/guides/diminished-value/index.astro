---
import BaseLayout from "@layouts/BaseLayout.astro";
import ClusterHubList from "@components/ClusterHubList.astro";
import { clusterHubSchema } from "@lib/seo/hub-schema";

const title = "Diminished Value Guides: Claims, 17c and Evidence";
const description =
  "Your car was repaired but is now worth less. Guides, a calculator and a letter template for diminished value claims, with the 17c formula's limits explained.";
const path = "/guides/diminished-value/";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://www.fairclaimcalculator.com/" },
      { "@type": "ListItem", position: 2, name: "Guides", item: "https://www.fairclaimcalculator.com/guides/" },
      { "@type": "ListItem", position: 3, name: "Diminished value", item: `https://www.fairclaimcalculator.com${path}` },
    ],
  },
  clusterHubSchema("diminished-value", "Diminished value guides", description, path),
];
---
<BaseLayout title={title} description={description} path={path} structuredData={structuredData}>
  <div class="container hub-container">
    <p class="breadcrumb-text"><a href="/">Home</a> / <a href="/guides/">Guides</a> / Diminished value</p>
    <h1 class="page-title">Diminished Value Guides</h1>
    <p class="lead">
      Diminished value is the drop in what your car is worth because it now has an accident on its
      history, even after a good repair. These guides explain who can claim it, how it is estimated
      and what evidence an insurer is likely to take seriously.
    </p>

    <h2>Where to start</h2>
    <ul class="start-list">
      <li>
        <strong>New to the idea?</strong> Start with
        {" "}<a href="/guides/diminished-value/what-is-diminished-value/">what diminished value is</a>, then
        the difference between
        {" "}<a href="/guides/diminished-value/inherent-vs-repair-related-diminished-value/">inherent and
        repair-related loss</a>.
      </li>
      <li>
        <strong>Want a number?</strong> The <a href="/calculators/diminished-value-baseline/">diminished value
        calculator</a> shows a 17c-style baseline next to real listings for clean and accident-history
        cars. Read <a href="/guides/diminished-value/the-17c-formula-history-calculation-and-limits/">the
        17c formula's limits</a> first: it is a commonly used starting point, not a legal standard, and
        insurers often reject it.
      </li>
      <li>
        <strong>Ready to claim?</strong> Check whether
        {" "}<a href="/guides/diminished-value/state-laws-first-party-diminished-value-claims/">your state allows a
        claim on your own policy</a>, build your
        {" "}<a href="/guides/diminished-value/building-diminished-value-market-evidence/">market evidence</a>,
        then send the <a href="/forms/diminished-value-claim-letter/">claim letter template</a>.
      </li>
      <li>
        <strong>Leased car, or damage close to the total loss line?</strong> See
        {" "}<a href="/guides/diminished-value/leased-vehicle-diminished-value/">diminished value on a leased car</a>
        {" "}and <a href="/guides/claim-process/diminished-value-vs-total-loss-which-claim/">which claim fits</a>.
      </li>
    </ul>
    <p>
      Claims against the at-fault driver's insurer and claims on your own policy follow different
      rules, and they vary by state and by policy wording. These guides are educational; for a
      claim worth pursuing, a licensed appraiser or attorney in your state can tell you what applies.
    </p>

    <ClusterHubList clusterId="diminished-value" />
  </div>
</BaseLayout>

<style>
  .hub-container { max-width: 900px; }
  .start-list li { margin-bottom: 10px; }
</style>
