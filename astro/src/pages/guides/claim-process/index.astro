---
import BaseLayout from "@layouts/BaseLayout.astro";
import ClusterHubList from "@components/ClusterHubList.astro";
import { clusterHubSchema } from "@lib/seo/hub-schema";

const title = "Car Insurance Claim Guides: Rentals, Offers, Complaints";
const description =
  "How a car insurance claim works after the crash: whose insurer pays, rental cars, low offers, outside help and complaints, with templates and a free tracker.";
const path = "/guides/claim-process/";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://www.fairclaimcalculator.com/" },
      { "@type": "ListItem", position: 2, name: "Guides", item: "https://www.fairclaimcalculator.com/guides/" },
      { "@type": "ListItem", position: 3, name: "Claims and disputes", item: `https://www.fairclaimcalculator.com${path}` },
    ],
  },
  clusterHubSchema("claim-process", "Car insurance claim guides", description, path),
];
---
<BaseLayout title={title} description={description} path={path} structuredData={structuredData}>
  <div class="container hub-container">
    <p class="breadcrumb-text"><a href="/">Home</a> / <a href="/guides/">Guides</a> / Claims and disputes</p>
    <h1 class="page-title">Car Insurance Claim Guides</h1>
    <p class="lead">
      Most of a car insurance claim happens after the tow truck leaves: deciding whose insurer to
      claim from, getting a rental, checking the offer and, sometimes, pushing back. These guides
      take you through it in order, with a template or tool at each step.
    </p>

    <h2>Where to start</h2>
    <ul class="start-list">
      <li>
        <strong>Just had the accident?</strong> Follow the
        {" "}<a href="/guides/claim-process/what-to-do-after-a-car-accident/">after-an-accident checklist</a>
        {" "}and check <a href="/guides/accident-reporting/">whether your state requires a crash report</a>.
      </li>
      <li>
        <strong>Filing the claim?</strong> Decide between
        {" "}<a href="/guides/claim-process/first-party-vs-third-party-auto-claims/">your own policy and the other
        driver's</a>, and start a record in the <a href="/my-claim/">My Claim tracker</a> or the printable
        {" "}<a href="/forms/claim-communication-log/">claim log</a>. Dates and names matter if the claim stalls.
      </li>
      <li>
        <strong>Without a car?</strong> See when the insurer pays for
        {" "}<a href="/guides/claim-process/rental-car-loss-of-use-reimbursement/">a rental or loss of use</a> and
        check the offer with the <a href="/calculators/loss-of-use-reimbursement/">loss of use calculator</a>.
      </li>
      <li>
        <strong>Offer too low, or the claim going nowhere?</strong> Start with
        {" "}<a href="/guides/claim-process/how-to-respond-to-a-lowball-offer/">responding to a lowball
        offer</a>, then the <a href="/calculators/claim-letter-builder/">claim letter generator</a>. If that
        fails, see <a href="/guides/claim-process/when-to-consider-an-independent-appraisal-or-attorney/">when
        to bring in an appraiser or attorney</a> and
        {" "}<a href="/guides/claim-process/filing-a-complaint-with-your-state-insurance-department/">how to
        file a complaint</a> with your state insurance department.
      </li>
    </ul>
    <p>
      This site covers vehicle and property damage claims only, not injury claims. The guides are
      educational and cite their sources; your policy and your state's rules decide the details.
    </p>

    <ClusterHubList clusterId="claim-process" />

    <h2>After an accident</h2>
    <ClusterHubList clusterId="accident" />
  </div>
</BaseLayout>

<style>
  .hub-container { max-width: 900px; }
  .start-list li { margin-bottom: 10px; }
</style>
