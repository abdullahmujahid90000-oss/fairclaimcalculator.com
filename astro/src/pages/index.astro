---
import BaseLayout from "@layouts/BaseLayout.astro";
import { AUTHOR } from "@lib/site/author";

const title = "Free Car Insurance Claim Calculators | FairClaimCalculator";
const description =
  "Free tools for U.S. drivers after a car accident: see if your car is totaled, estimate your payout, check diminished value and track your claim.";
const path = "/";

// Guide counts come from the files themselves, so they never go stale.
const guideFiles = Object.keys(import.meta.glob("./guides/*/*/index.astro"));
const countIn = (cluster: string) => guideFiles.filter((f) => f.startsWith(`./guides/${cluster}/`) && !f.includes("[")).length;
const guideCount = ["total-loss", "diminished-value", "claim-process"].reduce((n, c) => n + countIn(c), 0);

const situations = [
  {
    icon: "🚗",
    title: "My car was totaled",
    text: "See whether your state's rule applies and how much the insurer should pay.",
    links: [
      { label: "Is my car totaled?", href: "/calculators/total-loss-threshold-checker/" },
      { label: "Estimate my payout", href: "/calculators/total-loss-offer-audit/" },
    ],
  },
  {
    icon: "🔧",
    title: "My car is being repaired",
    text: "A car with an accident on its record is worth less. You may be able to claim that loss.",
    links: [
      { label: "Diminished value calculator", href: "/calculators/diminished-value-baseline/" },
      { label: "Rental car reimbursement", href: "/calculators/loss-of-use-reimbursement/" },
    ],
  },
  {
    icon: "🚨",
    title: "I just had an accident",
    text: "What to do at the scene, whether you must report it in your state, and who to call.",
    links: [
      { label: "What to do after an accident", href: "/guides/claim-process/what-to-do-after-a-car-accident/" },
      { label: "Reporting rules by state", href: "/guides/accident-reporting/" },
    ],
  },
  {
    icon: "📄",
    title: "The offer looks too low",
    text: "Find the errors that lower valuations and answer them in writing, with evidence.",
    links: [
      { label: "How to dispute a valuation", href: "/guides/total-loss/how-to-dispute-a-total-loss-valuation/" },
      { label: "Write my response letter", href: "/calculators/claim-letter-builder/" },
    ],
  },
];

const tools = [
  { title: "Is My Car Totaled?", text: "Your state's total loss rule, the repair amount that crosses it, and how close you are.", href: "/calculators/total-loss-threshold-checker/" },
  { title: "Totaled Car Value", text: "Estimate your check: value, tax and fees, deductible, loan payoff. Then audit the valuation.", href: "/calculators/total-loss-offer-audit/" },
  { title: "Diminished Value", text: "The common insurer formula side by side with real market evidence for your car.", href: "/calculators/diminished-value-baseline/" },
  { title: "Loan or Lease Gap", text: "See what you would still owe the lender after a total loss payout.", href: "/calculators/gap-shortfall/" },
  { title: "Rental / Loss of Use", text: "Check what you can claim for a rental car or the days without your car.", href: "/calculators/loss-of-use-reimbursement/" },
  { title: "Claim Letter Builder", text: "Turn your evidence into a clear, factual letter to the adjuster.", href: "/calculators/claim-letter-builder/" },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "FairClaimCalculator",
    url: "https://www.fairclaimcalculator.com/",
    description: "Free tools and guides for U.S. drivers handling a car insurance claim: total loss, payouts, diminished value and claim tracking.",
  },
];
---
<BaseLayout title={title} description={description} path={path} structuredData={structuredData}>
  <section class="hero">
    <div class="hero-inner">
      <p class="eyebrow">Free for U.S. drivers · all 50 states</p>
      <h1>Free car insurance claim calculators, with every step shown</h1>
      <p class="hero-lead">
        Dealing with a totaled or damaged car? Find out where you stand in minutes: whether your car
        is totaled, what the insurer should pay, and what to say if the offer is wrong. No sign-up,
        and what you type stays in your browser.
      </p>
      <div class="hero-ctas">
        <a href="/calculators/total-loss-threshold-checker/" class="btn btn-light">Is my car totaled?</a>
        <a href="/my-claim/" class="btn btn-outline">Track my claim</a>
      </div>
    </div>
  </section>

  <section class="container section">
    <h2>Start with what happened</h2>
    <div class="situations">
      {situations.map((s) => (
        <div class="situation">
          <p class="situation-icon" aria-hidden="true">{s.icon}</p>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
          <ul>
            {s.links.map((l) => <li><a href={l.href}>{l.label} →</a></li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="container section">
    <h2>Most used tools</h2>
    <div class="tools">
      {tools.map((t) => (
        <a class="tool" href={t.href}>
          <h3>{t.title}</h3>
          <p>{t.text}</p>
          <span class="tool-go" aria-hidden="true">Open →</span>
        </a>
      ))}
    </div>
    <p><a href="/calculators/">See all calculators →</a></p>
  </section>

  <section class="band">
    <div class="container band-inner">
      <div>
        <p class="eyebrow eyebrow-dark">New</p>
        <h2>My Claim: keep your whole claim in one place</h2>
        <p>
          Claim number, adjuster, every call and email, a step-by-step checklist, and a nudge when the
          insurer goes quiet. Add reminders to your calendar and come back any time. It's saved only
          in your browser.
        </p>
        <a href="/my-claim/" class="btn btn-primary">Open my claim tracker</a>
      </div>
      <ol class="band-steps" aria-label="What the tracker does">
        <li>Save your claim details</li>
        <li>Tick off each step</li>
        <li>Log every call and email</li>
        <li>Get a follow-up reminder</li>
      </ol>
    </div>
  </section>

  <section class="container section">
    <h2>Guides that explain it plainly</h2>
    <p class="section-lead">
      {guideCount} guides on total loss, diminished value and the claim process, plus accident
      reporting rules for every state. Each one cites its sources and says what it can't tell you.
    </p>
    <div class="guides">
      <a class="guide" href="/guides/total-loss/"><h3>Total loss</h3><p>{countIn("total-loss")} guides: valuation, state rules, GAP, disputing an offer.</p></a>
      <a class="guide" href="/guides/diminished-value/"><h3>Diminished value</h3><p>{countIn("diminished-value")} guides: what it is, the 17c formula, state rules, evidence.</p></a>
      <a class="guide" href="/guides/claim-process/"><h3>Claim process</h3><p>{countIn("claim-process")} guides: after a crash, rental cars, low offers, complaints.</p></a>
      <a class="guide" href="/guides/accident-reporting/"><h3>Accident reporting by state</h3><p>When you must report a crash, to whom, and the official form.</p></a>
      <a class="guide" href="/forms/"><h3>Free forms and letters</h3><p>Printable accident sheet, claim log, dispute and demand letters.</p></a>
    </div>
  </section>

  <section class="container section trust">
    <h2>Why people trust these tools</h2>
    <div class="trust-grid">
      <div><h3>The math is shown</h3><p>Every result shows each step, so you can check it or hand it to your adjuster.</p></div>
      <div><h3>Private by design</h3><p>Calculators run in your browser. What you type is not sent to us.</p></div>
      <div><h3>Sources you can check</h3><p>State rules link to the statute or agency they come from. See our <a href="/sources/">sources</a>.</p></div>
      <div><h3>Honest limits</h3><p>We say what a tool can't tell you. We're not lawyers or insurers, and we don't sell your data.</p></div>
    </div>
    <div class="author-card">
      <div class="avatar" aria-hidden="true">{AUTHOR.initials}</div>
      <div>
        <h3>{AUTHOR.name}</h3>
        <p>
          An independent research and editorial team, not attorneys, insurers or appraisers. Read
          how we work in our <a href="/about/">About page</a> and <a href="/editorial-policy/">Editorial Policy</a>.
        </p>
      </div>
    </div>
    <div class="disclaimer-box">
      <strong>Educational tools, not legal advice.</strong>
      FairClaimCalculator helps you organize facts and check arithmetic. It doesn't tell you what
      you are legally owed or replace an attorney, appraiser or your insurer's review. See our
      <a href="/disclaimer/">full disclaimer</a>.
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    background: radial-gradient(1200px 400px at 85% -10%, rgba(255,255,255,0.14), transparent 60%),
      linear-gradient(135deg, var(--color-primary-dark), var(--color-primary) 55%, var(--color-primary-light));
    color: #fff;
  }
  .hero-inner { max-width: var(--max-width-wide); margin: 0 auto; padding: 56px 20px 60px; }
  .eyebrow { text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.78rem; font-weight: 700; margin: 0 0 10px; opacity: 0.9; }
  .eyebrow-dark { color: var(--color-primary); opacity: 1; }
  .hero h1 { font-size: clamp(1.9rem, 4.5vw, 2.9rem); line-height: 1.15; margin: 0 0 16px; max-width: 760px; }
  .hero-lead { font-size: 1.12rem; max-width: 640px; margin: 0 0 26px; color: rgba(255,255,255,0.92); }
  .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; }

  .btn { display: inline-flex; align-items: center; padding: 13px 22px; border-radius: 9px; font-weight: 700; text-decoration: none; min-height: var(--touch-target-min); }
  .btn-light { background: #fff; color: var(--color-primary-dark); }
  .btn-light:hover { background: var(--color-primary-tint); }
  .btn-outline { border: 2px solid rgba(255,255,255,0.8); color: #fff; }
  .btn-outline:hover { background: rgba(255,255,255,0.12); }
  .btn-primary { background: var(--color-primary); color: #fff; }
  .btn-primary:hover { background: var(--color-primary-dark); }

  .section { padding-top: 44px; }
  .section h2 { font-size: 1.6rem; margin: 0 0 18px; }
  .section-lead { color: var(--color-text-muted); max-width: 680px; }
  .container { max-width: var(--max-width-wide); }

  .situations { display: grid; gap: 16px; grid-template-columns: 1fr; }
  @media (min-width: 640px) { .situations { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1000px) { .situations { grid-template-columns: repeat(4, 1fr); } }
  .situation { border: 1px solid var(--color-border); border-radius: 14px; padding: 20px; background: var(--color-bg); box-shadow: var(--shadow-sm); }
  .situation-icon { font-size: 1.8rem; margin: 0 0 6px; }
  .situation h3 { margin: 0 0 6px; font-size: 1.12rem; color: var(--color-primary-dark); }
  .situation p { margin: 0 0 12px; color: var(--color-text-muted); font-size: 0.95rem; }
  .situation ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 4px; }
  .situation a { font-weight: 600; display: inline-flex; min-height: 36px; align-items: center; color: var(--color-primary); }

  .tools { display: grid; gap: 14px; grid-template-columns: 1fr; margin-bottom: 14px; }
  @media (min-width: 640px) { .tools { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1000px) { .tools { grid-template-columns: repeat(3, 1fr); } }
  .tool { display: block; border: 1px solid var(--color-border); border-radius: 14px; padding: 18px 20px; text-decoration: none; color: inherit; transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s; }
  .tool:hover, .tool:focus-visible { border-color: var(--color-primary-light); box-shadow: var(--shadow-lg); transform: translateY(-2px); }
  .tool h3 { margin: 0 0 6px; color: var(--color-primary-dark); font-size: 1.08rem; }
  .tool p { margin: 0 0 10px; color: var(--color-text-muted); font-size: 0.93rem; }
  .tool-go { font-weight: 700; color: var(--color-primary); font-size: 0.9rem; }

  .band { background: var(--color-primary-tint); margin-top: 48px; padding: 40px 0; border-top: 1px solid #cfe5d6; border-bottom: 1px solid #cfe5d6; }
  .band-inner { display: grid; gap: 24px; align-items: center; }
  @media (min-width: 820px) { .band-inner { grid-template-columns: 3fr 2fr; } }
  .band h2 { margin: 0 0 10px; font-size: 1.6rem; }
  .band p { max-width: 620px; }
  .band-steps { margin: 0; padding: 18px 18px 18px 40px; background: #fff; border-radius: 14px; border: 1px solid #cfe5d6; display: grid; gap: 8px; font-weight: 600; }

  .guides { display: grid; gap: 14px; grid-template-columns: 1fr; }
  @media (min-width: 640px) { .guides { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1000px) { .guides { grid-template-columns: repeat(3, 1fr); } }
  .guide { display: block; border: 1px solid var(--color-border); border-radius: 12px; padding: 16px 18px; text-decoration: none; color: inherit; }
  .guide:hover { border-color: var(--color-primary-light); }
  .guide h3 { margin: 0 0 4px; font-size: 1.02rem; color: var(--color-primary-dark); }
  .guide p { margin: 0; color: var(--color-text-muted); font-size: 0.9rem; }

  .trust-grid { display: grid; gap: 18px; grid-template-columns: 1fr; }
  @media (min-width: 640px) { .trust-grid { grid-template-columns: 1fr 1fr; } }
  .trust-grid h3 { margin: 0 0 4px; font-size: 1.02rem; }
  .trust-grid p { margin: 0; color: var(--color-text-muted); font-size: 0.93rem; }
  .author-card { display: flex; gap: 14px; align-items: flex-start; margin: 26px 0; padding: 18px; border-radius: 12px; background: var(--color-bg-soft); border: 1px solid var(--color-border); }
  .avatar { flex: none; width: 46px; height: 46px; border-radius: 50%; display: grid; place-items: center; background: var(--color-primary); color: #fff; font-weight: 800; }
  .author-card h3 { margin: 0 0 4px; }
  .author-card p { margin: 0; font-size: 0.93rem; }
  .disclaimer-box { background: var(--color-warning-bg); border: 1px solid var(--color-warning-border); border-radius: var(--radius); padding: 16px 18px; font-size: 0.9rem; margin: 0 0 50px; }
  .disclaimer-box strong { display: block; margin-bottom: 4px; }
</style>
